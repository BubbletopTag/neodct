#!/bin/sh
# nd-platform -- "qemu or hw", for the half of the OS that is busybox sh.
#
# The init scripts cannot link libneodct, so they cannot ask nd_platform()
# (neodct/src/include/nd_platform.h). This is the same answer, read out of the
# same file, with the same three values.
#
# The INITRAMFS is not among its callers and cannot be. Both this script and
# the file it reads live in the root squashfs, which is not mounted yet when
# the initramfs runs, and nothing in neodct/initramfs/ asks which machine it
# is on anyway -- post-build-system-metadata.sh has the reasoning.
#
#     nd-platform             print the platform word: qemu, hw or unknown
#     nd-platform is hw       exit 0 only when the platform is hw
#     nd-platform is qemu     exit 0 only when the platform is qemu
#     nd-platform get KEY     print the value of KEY; exit 1 when it is absent
#
# ============ WHY `is` AND NOT AN EXIT STATUS ON THE BARE FORM ============
#
# nd_platform.h's rule is that UNKNOWN may decide a cost question and may
# never decide a truth question, and the two predicates are separate so that
# nobody writes "not qemu" and means "hardware". A bare command whose exit
# status meant "the record was readable" would be read as "this is a phone" by
# the first person in a hurry -- `nd-platform && start_the_modem_wait` looks
# exactly like the check it is not. So the truth questions are spelled out,
# they mirror nd_platform_is_hw() and nd_platform_is_qemu() one for one, and
# there is no negation form here either.
#
# ============ HOW IT READS THE FILE ============
#
# `while IFS='=' read`, never `.` -- AGENTS.md is explicit that a record is
# parsed and never sourced, so a value can never execute. The value charset is
# narrower than the file format allows, the same guard S45modem puts on its
# cache: everything this file can legitimately carry is a lowercase token, and
# a value that is not one is a file we do not understand rather than one to
# pass on to a caller.
#
# NEODCT_PLATFORM overrides the file with a platform word, and it carries no
# board: a board name is a claim about a piece of hardware and an environment
# variable is not evidence of one.
#
# IT NO LONGER MATCHES THE C, AND THAT IS WORTH SAYING PLAINLY. Since
# DECISIONS.md D2 the environment loses to the compiled-in constant on an image
# build -- nd_platform.h has the reasoning, which is that NEODCT_PLATFORM can
# come from /NeoDCT/User/env.sh and an update-proof way to make a phone
# simulate its radio is not a discriminator. Here it still wins, because this
# script has no constant to lose to and its remaining override is a host-test
# hook (neodct/tests/test_nd_platform_helper.py drives it). So on a devenv
# image an exported NEODCT_PLATFORM makes `nd-platform is hw` true while
# libneodct answers qemu, with no diagnostic anywhere: nd_platform_mismatch()
# compares the constant against the FILE and knows nothing about this. Somebody
# chasing a divergence between the two answers should check the environment
# first.
#
# NEODCT_PLATFORM_FILE is the host tests' hook, in the shape ndsys-apply.sh
# uses for the same purpose: the default is the real absolute path, and a test
# points it at an ordinary file.
#
# ============ AND WHAT THIS SCRIPT CANNOT SEE ============
#
# Since DECISIONS.md D2 the C answer has a SECOND source that outranks this
# file: ND_BUILD_PLATFORM, compiled into libneodct. nd_platform() treats a
# disagreement between the two as a mis-assembled image and names neither
# machine. This script cannot see the constant at all, so it cannot detect
# that, and it will happily answer "hw" on an image the C has already refused
# to call anything.
#
# That gap is accepted rather than papered over. It cannot be closed here:
# busybox sh cannot read a symbol out of a shared library, and delegating to a
# C binary would put a process spawn in the boot path. And it cannot arise for
# any image this tree builds: /NeoDCT/platform and the compiled constant both
# come out of neodct/scripts/platform-id.sh, one table with one entry per image
# tag, so they agree by construction. What is left for the C check to catch is
# a hand-assembled or tampered image, and a shell script on that image is not
# the instrument that should be finding it -- nd-selftest is, and it fails on
# it before it runs anything else.
#
# TWO INIT SCRIPTS ASK, AND THEY DO NOT COST THE SAME. S17audio does not ask at
# all; its only mention is a comment about settings.prop parsing.
#
#   S10udevd   whether to wait for a ttyUSB to enumerate. A COST question in
#              nd_platform.h's sense: on a contested image the worst answer
#              costs a wait nobody needed.
#
#   S90display `is qemu` and then `exit 0`, which is a TRUTH question about a
#              panel and is NOT free to get wrong. A contested phone whose
#              /NeoDCT/platform says qemu exits before starting neodct_displayd
#              and before granting the gpio53 backlight, so the owner gets a
#              dark screen with nothing to light it -- the exact failure
#              S90display's own header says it was rewritten to end. If that
#              stops being hypothetical, the fix is in S90display and not here:
#              fall through to the `[ -e /dev/spidev0.0 ]` evidence for
#              anything that is not a positive `is hw`, which costs a genuine
#              QEMU image nothing (there is no spidev node to find).
: "${NEODCT_PLATFORM_FILE:=/NeoDCT/platform}"

usage() {
    echo "usage: nd-platform [is hw|qemu | get KEY]" >&2
    exit 2
}

# Prints the value of one key, or nothing. Returns 1 when the key is absent.
platform_get() {
    _want="$1"
    _found=""
    [ -r "$NEODCT_PLATFORM_FILE" ] || return 1
    # `|| [ -n "$_key" ]` catches a final line with no newline after it. read
    # returns non-zero there even though it has filled the variables, so the
    # plain form silently drops the last record -- which in this file is
    # image=, the key least likely to be missed until something needs it. The
    # C reader (nd_props, B-1) has never had that edge, and the two readers
    # agreeing about one four-line file is the point of the file.
    while IFS='=' read -r _key _value || [ -n "$_key" ]; do
        [ "$_key" = "$_want" ] || continue
        case "$_value" in
            ''|*[!A-Za-z0-9._-]*) continue ;;
        esac
        _found="$_value"
    done < "$NEODCT_PLATFORM_FILE"
    [ -n "$_found" ] || return 1
    printf '%s\n' "$_found"
    return 0
}

# The platform word, and never empty. An unreadable file, an absent key and a
# word this script has never heard of all land on "unknown", which is a real
# answer and not a synonym for either of the others.
platform_word() {
    _word="${NEODCT_PLATFORM:-}"
    [ -n "$_word" ] || _word="$(platform_get platform)" || _word=""
    case "$_word" in
        hw|qemu) printf '%s\n' "$_word" ;;
        *)       printf 'unknown\n' ;;
    esac
}

case "${1:-}" in
    "")
        platform_word
        ;;
    is)
        [ $# -eq 2 ] || usage
        case "$2" in
            hw|qemu) [ "$(platform_word)" = "$2" ] ;;
            *)       usage ;;
        esac
        ;;
    get)
        [ $# -eq 2 ] || usage
        platform_get "$2"
        ;;
    *)
        usage
        ;;
esac
