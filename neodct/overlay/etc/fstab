# /etc/fstab
#
# Root is a read-only squashfs and stays that way -- there is deliberately
# no remount,rw anywhere in the boot path. Everything writable is either a
# tmpfs listed here or the user-data partition, which the initramfs mounts
# and mount --moves to /NeoDCT/User before switch_root (see
# neodct/initramfs/init), so it needs no entry here.
#
# ============ nosuid,nodev, AND WHY THEY ARE HERE BEFORE THEY BITE ============
#
# Every writable filesystem gets nosuid,nodev. Today that changes nothing --
# there is one user and it is root, so a setuid bit grants what the process
# already has. The moment ndusr_ut exists (SECURITY-PLAN.md section 1) a
# world-writable /tmp without nosuid is a one-line privilege escalation: drop
# a setuid-root binary there, run it, and the confinement is over. Putting the
# options in while they are inert is the cheap moment; adding them after the
# user exists means shipping a window where they are missing.
#
# noexec is deliberately NOT here. /tmp and /run hold no programs today, but
# they are the obvious place for a future helper, and noexec breaks dlopen()
# as well as execve() -- see SECURITY-PLAN.md section 1 on RetroArch cores and
# nd-apprun's own app.so. The card's arrival partition is where noexec earns
# its place, because that is where bytes chosen by a stranger land.
#
# <file system>	<mount pt>	<type>	<options>	<dump>	<pass>
/dev/root	/		auto	ro,noauto	0	1
proc		/proc		proc	defaults	0	0
devpts		/dev/pts	devpts	defaults,gid=5,mode=620,ptmxmode=0666	0	0
tmpfs		/dev/shm	tmpfs	mode=1777,nosuid,nodev	0	0
tmpfs		/tmp		tmpfs	mode=1777,nosuid,nodev	0	0
tmpfs		/run		tmpfs	mode=0755,nosuid,nodev	0	0
sysfs		/sys		sysfs	defaults	0	0
