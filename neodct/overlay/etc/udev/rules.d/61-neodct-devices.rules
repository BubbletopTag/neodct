# What ndusr may open once it stops being root.
#
# SECURITY-PLAN.md section 5 Phase 1, and the table in SECURITY-AUDIT.md
# section 6: every device the UI touches, and the group that grants it.
# Most of them need nothing here -- eudev's own 50-udev-default.rules already
# puts /dev/fb0 in video, /dev/input/event* in input, /dev/snd/* in audio and
# /dev/ttyUSB* in dialout, all at 0660. Those four are the common case and
# they are already right.
#
# This file is the remainder: the nodes and attributes with no stock rule,
# which are therefore root:root 0600 (a device node with no GROUP= gets 0600
# from eudev, not 0660) or root-owned 0644 in sysfs.
#
# NOTHING HERE CHANGES ANYTHING TODAY. Every process on the phone is root and
# root ignores all of it. It is here so that the users exist, the groups are
# granted and the rules are proven before anything drops privilege -- which
# is the order SECURITY-PLAN.md asks for, and the opposite of discovering on
# a phone that the keypad stopped working.
#
# A wrong group name fails as a permission problem rather than a build error:
# eudev logs one line and falls back to gid 0, which also drops the node to
# 0600. Every group named below is created by neodct/configs/users-table.txt.

# --- i2c: the keypad expander and the fuel gauge -------------------------
#
# The one device class with no stock rule at all, and the one the audit
# predicted would bite. /dev/i2c-3 carries the PCF8575 the keypad matrix
# hangs off (nd_pcf8575.c, nd_keypadsetup.c) and the MAX17048 fuel gauge
# (nd_battery.c). Without this it is root:root 0600 and a non-root UI has no
# keys and no battery reading.
#
# Not granted to ndusr_ut. An i2c bus is a bus: anything on it is reachable
# by address, and "the browser can talk to the fuel gauge" is not a sentence
# with a good ending.
SUBSYSTEM=="i2c-dev", GROUP="i2c", MODE="0660"

# --- backlight ------------------------------------------------------------
#
# nd_backlight.c writes brightness. A udev rule is the ordinary way to hand
# an attribute to a group; the alternative is a setuid helper for something
# that is one integer.
SUBSYSTEM=="backlight", ACTION=="add", \
    RUN+="/bin/sh -c 'chgrp video /sys%p/brightness 2>/dev/null; chmod 0664 /sys%p/brightness 2>/dev/null'"

# --- cpufreq --------------------------------------------------------------
#
# nd_cpufreq.c sets scaling_min_freq and scaling_max_freq -- the phone drops
# its ceiling on the home screen and raises it for Koki. cpufreq attributes
# are not a udev subsystem event on every kernel, so this is attached to the
# cpu subsystem's add.
SUBSYSTEM=="cpu", ACTION=="add", \
    RUN+="/bin/sh -c 'for f in /sys%p/cpufreq/scaling_min_freq /sys%p/cpufreq/scaling_max_freq /sys%p/cpufreq/scaling_governor; do [ -e \"$$f\" ] && { chgrp ndusr \"$$f\"; chmod 0664 \"$$f\"; }; done' 2>/dev/null"

# --- uinput ---------------------------------------------------------------
#
# apps/Browser/main.c synthesises a uinput device so netsurf-fb sees the
# arrow keys the core chose to give it and nothing else. The core is what
# opens /dev/uinput, so this grants the group the core will run as -- not
# ndusr_ut, which must keep receiving keys rather than injecting them.
KERNEL=="uinput", GROUP="input", MODE="0660"

# --- rtc ------------------------------------------------------------------
#
# nd_clock.c sets the hardware clock after an SNTP sync. The stock rules
# leave /dev/rtc0 root:root 0600. This is the smaller half of the problem --
# the other half is clock_settime(), which is CAP_SYS_TIME and cannot be
# given away with a mode bit; see SECURITY-PLAN.md section 5 Phase 1 on
# preferring an auditable helper to a capability on the whole core.
KERNEL=="rtc[0-9]*", GROUP="ndusr", MODE="0660"
