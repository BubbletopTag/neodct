#!/bin/sh
# Point ALSA's "default" at the USB sound card, without dmix.
#
# Two problems, one file.
#
# 1. The onboard rv-adcodec enumerates as card 0 and is not wired to
#    anything on this phone. Anything opening "default" plays into it and
#    the owner hears nothing, which is indistinguishable from broken
#    audio.
#
# 2. ALSA's stock "default" mixes through dmix, and dmix needs an ALSA
#    timer this kernel does not provide. Opening it fails outright. So
#    the slave here is plain hw -- one program at a time gets the card,
#    which is what a phone wants anyway: a ringtone and a call are not
#    supposed to overlap.
#
# Written at boot rather than shipped as a fixed file because the card
# number moves. It is 1 when the sound card is plugged straight in and
# something else once it is behind the hub the modem shares, and a
# hardcoded number is wrong on exactly the day somebody rearranges the
# insides of the phone.
#
# /etc is read-only squashfs, so this lands in /run and /etc/asound.conf
# is a symlink to it -- the same arrangement resolv.conf uses.

CONF=/run/asound.conf

find_usb_card() {
    # USB cards are the ones with a usbid. That is a more reliable test
    # than the name, which is whatever the vendor felt like writing.
    for path in /proc/asound/card[0-9]*; do
        [ -e "$path/usbid" ] || continue
        card="${path##*/card}"
        case "$card" in
            ''|*[!0-9]*) continue ;;
        esac
        echo "$card"
        return 0
    done
    return 1
}

case "$1" in
    start)
        CARD=$(find_usb_card) || {
            echo "[AUDIO] no USB sound card; leaving ALSA defaults alone"
            exit 0
        }
        NAME=$(sed -n "s/^ *$CARD \[\([^]]*\)\].*/\1/p" /proc/asound/cards \
               | head -1 | sed 's/[[:space:]]*$//')
        cat > "$CONF" <<EOF
# Generated by /etc/init.d/S17audio. Edits are overwritten at boot.
pcm.!default {
    type plug
    slave.pcm {
        type hw
        card $CARD
        device 0
    }
}

ctl.!default {
    type hw
    card $CARD
}
EOF
        echo "[AUDIO] default -> card $CARD (${NAME:-USB}), dmix bypassed"
        ;;
    stop)
        rm -f "$CONF"
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
