#!/bin/sh
# Point ALSA's "default" at the USB sound card, without dmix.
#
# Two problems, one file.
#
# 1. The onboard rv-adcodec enumerates as card 0 and is not wired to
#    anything on this phone. Anything opening "default" plays into it and
#    the owner hears nothing, which is indistinguishable from broken
#    audio.
#
# 2. ALSA's stock "default" mixes through dmix, and dmix needs an ALSA
#    timer this kernel does not provide. Opening it fails outright. So
#    the slave here is plain hw -- one program at a time gets the card,
#    which is what a phone wants anyway: a ringtone and a call are not
#    supposed to overlap.
#
# Written at boot rather than shipped as a fixed file because the card
# number moves. It is 1 when the sound card is plugged straight in and
# something else once it is behind the hub the modem shares, and a
# hardcoded number is wrong on exactly the day somebody rearranges the
# insides of the phone.
#
# /etc is read-only squashfs, so this lands in /run and /etc/asound.conf
# is a symlink to it -- the same arrangement resolv.conf uses.

# Overridable so neodct/tests/test_s17audio.py can drive the whole script
# against a fake /proc/asound and a fake amixer. Nothing on the phone sets
# these; the defaults are the real paths.
: "${NEODCT_ASOUND_CONF:=/run/asound.conf}"
: "${NEODCT_PROC_ASOUND:=/proc/asound}"
: "${NEODCT_AMIXER:=amixer}"
: "${NEODCT_SETTINGS:=/NeoDCT/User/settings.prop}"
# Who owns the file afterwards. nd_btaudio.c rewrites it; that code runs in the
# core and in Settings, both of which are ndusr now. See conf_owner().
: "${NEODCT_ASOUND_OWNER:=ndusr}"

CONF="$NEODCT_ASOUND_CONF"

# ============ AND WHO MAY REWRITE IT AFTERWARDS ============
#
# This file is not written once. nd_btaudio_route_to() rewrites it every time
# earbuds connect or disconnect -- that is the entire routing mechanism, since
# everything on this phone opens ALSA's "default" and this is what "default"
# resolves to. Before 0.5.0b the process doing the rewriting was root and this
# did not have to be said; now it is the core, or Settings, and both are ndusr.
#
# /run is a 0755 root:root tmpfs (see /etc/fstab), so ndusr cannot CREATE a
# file there. What it can do is rewrite one it owns, in place -- which is why
# the owner is handed over here, at boot, by the one process that still can.
# Without it nd_btaudio_write_conf() returns ND_ERR_IO and the phone cannot
# route audio to earbuds, or back off them again.
#
# 0644 rather than 0640, and it is deliberate: mpv and netsurf run as ndusr_ut
# and they read this file to find the sound card. It says which card is card 1.
# There is nothing in it to keep.
#
# Silent when there is no ndusr -- an image built without
# BR2_ROOTFS_USERS_TABLES runs everything as root and needs none of this.
# AND THE DIRECTORY BESIDE IT, for the same reason and it was missed.
#
# nd_btaudio_route_to() does not only rewrite asound.conf: before it points
# "default" at earbuds it SAVES the boot-time file, so disconnecting restores
# the exact bytes rather than guessing them again. That save is a second file,
# and the paragraph above says why ndusr cannot create one in /run -- so the
# save silently failed on every phone, and disconnecting fell through to the
# regenerate path.
#
# Which would be harmless if the two agreed about the answer. They do not:
# this script picks the card with a usbid (find_usb_card, card 1 here) and
# nd_btaudio.c's fallback picks the first card with a capture device (card 0,
# the onboard codec that is wired to nothing). Measured on the phone --
# switching Bluetooth off left "default" pointing at silence.
#
# A directory, not a chown of a file that does not exist yet: the save is
# created and removed as devices come and go, and ndusr has to be able to do
# both. 0755 so ndusr_ut can still read what is in it.
ASOUND_DIR=/run/asound.d

conf_owner() {
    mkdir -p "$ASOUND_DIR" 2>/dev/null
    chown "$NEODCT_ASOUND_OWNER:$NEODCT_ASOUND_OWNER" "$ASOUND_DIR" 2>/dev/null
    chmod 0755 "$ASOUND_DIR" 2>/dev/null
    [ -e "$CONF" ] || return 0
    chown "$NEODCT_ASOUND_OWNER:$NEODCT_ASOUND_OWNER" "$CONF" 2>/dev/null
    chmod 0644 "$CONF" 2>/dev/null
    return 0
}

find_usb_card() {
    # USB cards are the ones with a usbid. That is a more reliable test
    # than the name, which is whatever the vendor felt like writing.
    for path in "$NEODCT_PROC_ASOUND"/card[0-9]*; do
        [ -e "$path/usbid" ] || continue
        card="${path##*/card}"
        case "$card" in
            ''|*[!0-9]*) continue ;;
        esac
        echo "$card"
        return 0
    done
    return 1
}

# ============ HOW LOUD, AND WHO DECIDES ============
#
# This used to be `NEODCT_CAPTURE_LEVEL=80`, a bare constant chosen against
# the one microphone on the developer's desk. It is now the owner's, through
# system.hw.mic_gain -- which MicTest writes while you listen to the effect --
# and 70 when nothing has set it, chosen to reduce acoustic echo without
# making the electret hard to hear.
#
# settings.prop is READ AS DATA AND NEVER SOURCED. It lives on the writable
# user partition, which is the one place an attacker who has got a file onto
# this phone can write -- the same reason neodct/initramfs/init parses its
# records with `while IFS='=' read` instead of `.`, and the reason env.sh is
# gated on something outside that partition. A value from here reaches an
# amixer argument, so it is also checked to be one to three digits and no
# more than 100 before it gets there; anything else is the default.
#
# NEODCT_CAPTURE_LEVEL still wins if it is set, which is how a level is pinned
# when settings.prop cannot be consulted -- every boot before /NeoDCT/User is
# mounted -- and what test_the_environment_beats_the_settings_file() in
# neodct/tests/test_s17audio.py holds it to. The `:=` is the whole mechanism:
# the parse below runs only when the variable is unset.
: "${NEODCT_CAPTURE_LEVEL:=$(
    level=""
    if [ -r "$NEODCT_SETTINGS" ]; then
        # `|| [ -n "$key" ]` catches a final record with no newline after it.
        # read(1) returns non-zero at EOF even though it has already filled the
        # variables, so the plain form silently drops the last line -- and
        # settings.prop is written by nd_settings.c one key per line, so the
        # last line is whichever key was written last. A file ending
        # "system.hw.mic_gain=0" with no trailing newline gave the DEFAULT of
        # 100 here, which is to say the owner's saved gain was ignored on every
        # boot and nothing said so. /bin/nd-platform's platform_get() guards
        # the same edge on the same file format; two readers of one format
        # disagreeing about where it ends is a bug waiting for the other one.
        while IFS='=' read -r key value || [ -n "$key" ]; do
            [ "$key" = "system.hw.mic_gain" ] || continue
            level="$value"
        done < "$NEODCT_SETTINGS"
    fi
    case "$level" in
        ''|*[!0-9]*) level=70 ;;
    esac
    if [ "${#level}" -gt 3 ] || [ "$level" -gt 100 ]; then
        level=70
    fi
    echo "$level"
)}"

# Turn the capture path on. NOTHING ELSE IN THIS IMAGE DOES.
#
# There is no alsactl here, so no saved mixer state is restored at boot: the
# phone gets whatever the driver defaults to, every boot and every replug. The
# ONN microphone's defaults are open, so this was invisible for as long as that
# was the only microphone. A C-Media card with an electret soldered to it comes
# up with capture muted, and arecord then returns a flat line with no error at
# all -- silence that looks exactly like dead hardware, in MicTest and on a
# call alike.
#
# BY numid, NOT by simple-mixer name. The obvious version of this is
# `amixer sset Mic 80%`, and on the card this was written for it is wrong.
# A real C-Media adapter (0d8c:0014) offers:
#
#     Mic Capture Volume     Mic Capture Switch
#     Mic Playback Volume    Mic Playback Switch     <- monitor, mic to speaker
#     Auto Gain Control      Speaker Playback Volume/Switch
#
# ALSA's simple mixer merges the first two rows into ONE control called "Mic"
# carrying both pvolume and cvolume, so sset would raise the monitor path as
# well and put the microphone into the earpiece. On a phone that is feedback.
#
# The kernel's own control names do not have that ambiguity: anything ending
# "Capture Switch" or "Capture Volume" is unambiguously the capture path, and
# addressing it by numid avoids quoting a name that contains spaces.
#
# Auto Gain Control is deliberately LEFT ALONE, and it stays left alone now
# that the level beside it is adjustable. It is a real switch on this card and
# it might well help a quiet electret, but AGC on a codec this cheap pumps: it
# rides the noise floor up between words and ducks the first syllable after a
# pause, which on a call sounds like a bad line rather than like a quiet one.
# That is a sound-quality choice with no right answer, where the capture level
# is a correctness one -- a card at zero records nothing. If it is ever
# exposed it belongs behind its own setting, defaulting OFF, and not wired to
# the gain.
enable_capture() {
    card="$1"
    "$NEODCT_AMIXER" -c "$card" controls 2>/dev/null | while IFS= read -r line; do
        numid="${line%%,*}"
        case "$numid" in
            numid=*) ;;
            *) continue ;;
        esac
        case "$line" in
            *"Capture Switch'"*)
                "$NEODCT_AMIXER" -c "$card" cset "$numid" on > /dev/null 2>&1 ;;
            *"Capture Volume'"*)
                "$NEODCT_AMIXER" -c "$card" cset "$numid" \
                    "${NEODCT_CAPTURE_LEVEL}%" > /dev/null 2>&1 ;;
        esac
    done
}

case "$1" in
    start)
        CARD=$(find_usb_card) || {
            echo "[AUDIO] no USB sound card; leaving ALSA defaults alone"
            exit 0
        }
        NAME=$(sed -n "s/^ *$CARD \[\([^]]*\)\].*/\1/p" "$NEODCT_PROC_ASOUND/cards" \
               | head -1 | sed 's/[[:space:]]*$//')
        cat > "$CONF" <<EOF
# Generated by /etc/init.d/S17audio. Edits are overwritten at boot.
pcm.!default {
    type plug
    slave.pcm {
        type hw
        card $CARD
        device 0
    }
}

ctl.!default {
    type hw
    card $CARD
}
EOF
        conf_owner
        echo "[AUDIO] default -> card $CARD (${NAME:-USB}), dmix bypassed"
        enable_capture "$CARD"
        echo "[AUDIO] capture enabled on card $CARD at ${NEODCT_CAPTURE_LEVEL}%"
        ;;
    stop)
        # The speaker backup nd_btaudio.c leaves behind goes with it: a saved
        # route from the last session would otherwise be restored on top of a
        # card that may have been renumbered since.
        rm -f "$CONF" "$CONF.speaker"
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
