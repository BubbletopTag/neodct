#!/bin/sh
#
# S11udevall -- the rest of the udev coldplug.
#
# S10udevd triggers, settles AND VERIFIES the subsystems the UI cannot start
# without: see COLDPLUG_SUBSYSTEMS and DEVICE_GRANTS there. This is everything
# else -- the subsystem pass, and every device in /sys whose group nothing is
# waiting on.
#
# The division of labour is the whole point and it is easy to get wrong in one
# direction only. Anything the DROPPED core has to open must be in S10udevd's
# list, because this script runs in the background, at nice 10, while nd-core
# is already running as ndusr: a grant applied here is a grant applied after
# the process that needed it tried to open the device. That is not a slow
# grant, it is a race, and it presents as "sometimes the phone has no keys /
# no modem / no sound". If you add a rule to 61-neodct-devices.rules, add its
# subsystem THERE, not here.
#
# It is deliberately NOT in rcS's NEODCT_BOOT_CRITICAL list, so it runs in
# the background while the home screen is already drawing. It is numbered 11
# so that it is still the FIRST of the background scripts -- eudev renames
# network interfaces (the qmi_wwan one becomes wwp0s4u3i5 under QEMU, which
# is why S45modem matches by driver), and S40network, S41ethernet and
# S45modem all want that settled before they look. Keep it ahead of them.
#
SETTLE_TIMEOUT=30
[ -r /etc/default/udevd ] && . /etc/default/udevd

case "$1" in
    start)
        # No message on success: this is the invisible half of a step that
        # already printed "Starting udevd: OK".
        udevadm trigger --type=subsystems --action=add
        udevadm trigger --type=devices --action=add
        udevadm settle --timeout=$SETTLE_TIMEOUT \
            || echo "udevadm settle failed (full coldplug)"
        ;;
    stop|restart|reload)
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload}"
        exit 1
        ;;
esac
exit 0
