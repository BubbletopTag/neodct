#!/bin/sh
# Mount a removable card at /NeoDCT/User/sdcard and publish what was found.
#
# Called three ways:
#   neodct-sdcard scan            at boot, for a card already in the slot
#   neodct-sdcard add DEVNAME     from the udev rule when one is inserted
#   neodct-sdcard remove DEVNAME  from the udev rule when one is pulled. The
#                                 name is READ: the rule matches every block
#                                 partition on the phone and only this card's
#                                 disappearance is this card going away
#   neodct-sdcard format DEV      make a fresh NeoDCT card (destructive)
#   neodct-sdcard layout          restate the layout on the mounted card
#   neodct-sdcard setup           give a foreign ext card the NeoDCT folders
#                                 and take ownership of it -- the owner asked
#
# Only ever one at a time: the whole dispatcher runs under an flock, because
# `format` is minutes long and generates the uevents that call `add` and
# `remove`. See the bottom of the file.
#
# The state file is what System/core/Storage reads, so the UI never has to
# poke at block devices itself:
#   state=mounted|legacy|foreign|unmountable|unformatted|share|absent
#   device=  fstype=  label=
#   untrusted=<path>              empty unless this is a NeoDCT card with
#                                 somewhere for a download to go; see below
#
# A card is anything that is not the system or user-data partition -- those
# two come from the kernel cmdline, so this works the same on QEMU virtio
# and on a real SD slot.
#
# ============ ONE EXT4 PARTITION, AND WHY IT USED TO BE TWO FAT ============
#
# SECURITY-PLAN.md section 1, revised. A NeoDCT card was TWO FAT32 partitions
# and is now ONE ext4 one, and the reason is worth keeping because the old
# design was a correct answer to a real constraint.
#
# The constraint: a FAT filesystem HAS no ownership. chown and chmod do
# nothing on one. Permissions come from mount options -- uid=, gid=, fmask=,
# dmask= -- and those apply to the WHOLE FILESYSTEM AT ONCE. So there was no
# way to grant ndusr_ut a subdirectory of a card and deny it the rest: one
# mount, one uid, one gid. A card mounted for the browser was a card the
# browser owned entirely.
#
# The old way out was that a CARD can carry more than one FILESYSTEM: two
# partitions, two independent sets of ownership, no kernel feature and no
# filesystem change, and a card that still read on any computer. p1 belonged
# to ndusr and held what the owner copied on; p2 belonged to ndusr_ut, was
# mounted noexec, and held what arrived.
#
# What that could NOT express is an installed app. An app.so on p1 would have
# been 0640 ndusr:ndusr -- unreadable by the ndusr_ut process that has to
# dlopen it -- and making it readable meant making every file on p1 readable,
# the owner's music included. p2 is ndusr_ut's own, so an app there could
# rewrite itself, and it is noexec besides. Two partitions, and nowhere for
# an app to live. A third would have been the same trick a third time.
#
# ext4 records owner, group and mode PER INODE, so one filesystem says all of
# it at once, and the partition table stops being load-bearing:
#
#   .           0751 ndusr:ndusr      traverse, do not list
#   apps        0755 ndusr:ndusr      the owner installs here; an app cannot
#     <app>/    0755 ndusr:ndusr      its code -- files 0644, so an app can
#                                     read and run its own app.so and not
#                                     write it
#     <app>/data 0770 ndusr:ndusr_ut  the one thing the app may write
#   untrusted   0770 ndusr:ndusr_ut   downloads, browser and player state
#   media       0750 ndusr:ndusr      music, wallpapers, tones, backups,
#                                     updates -- ndusr_ut cannot read any
#
# The boundary is still PROVENANCE, not trust: did the owner choose to put
# this here, or did it arrive? What changed is that the answer is now written
# on the card rather than decided at mount time.
#
# ============ AND WHY THE LAYOUT IS RESTATED ON EVERY MOUNT ============
#
# Because ownership living ON the card means the card carries it to a PC and
# back. A person can chmod 0777 the lot, deliberately or with one bad umask
# on a copy, and the modes that arrive are therefore a claim about the past.
# apply_layout() runs on every mount, exactly as S00userdata restates the user
# partition on every boot. See card_is_ours() for how a card of ours is told
# apart from a stranger's, and why that decision does NOT go through blkid.
#
# The cost, stated plainly because the old header defended the opposite trade:
# Linux reads ext4 everywhere and Windows and macOS need a helper. That is the
# price of a card that knows who owns what.
#
# nosuid,nodev stay on every mount. FAT could not represent a setuid bit or a
# device node in the first place; ext4 can, so the options that were belt and
# braces on a FAT card are load-bearing on this one.
#
# ============ WHAT A FOREIGN CARD GETS ============
#
# Mounted, read, and otherwise left alone. It gets no layout pass -- chowning
# a stranger's card would be the phone quietly taking ownership of somebody's
# photographs -- and untrusted= stays empty, so a caller has nowhere to put a
# download, which is the correct answer rather than a degraded one.
#
# Which leaves one thing to say out loud. Not laying out the card means its
# root directory keeps whatever ownership the PC that made it left there, and
# that is frequently not something the core -- which is ndusr, not root -- can
# read at all. Such a card is published as `foreign`: it IS in the slot, it IS
# mounted, and it is the owner's to hand over with `setup` if they want to.
# Saying `mounted` for a card the UI then cannot list is what produces "the
# card may be locked or damaged" for a card that is neither. See after_mount().
#
# A NeoDCT card in the old FAT format is reported as `legacy`: it mounts, the
# owner's music plays, and the UI offers to reformat it. That erases the card,
# so it is offered and never done uninvited.
set -u

MOUNT_POINT="${NEODCT_SDCARD_MOUNT:-/NeoDCT/User/sdcard}"
# The arrival partition, mounted INSIDE the media one.
#
# That works, and it is not an accident: p1's dmask below is 0026, so its
# directories are 0751 -- ndusr_ut can traverse "sdcard" to reach "untrusted"
# by name while `ls` of the media side returns EACCES. Exactly the trick
# /NeoDCT/User itself uses, for exactly the same reason.
UNTRUSTED_NAME=untrusted
# A DIRECTORY on the card now, not a second partition.
#
# It was p2, a separate FAT filesystem, because FAT has no ownership of its
# own: uid=/gid=/fmask=/dmask= are mount options and apply to a whole
# filesystem, so "downloads are writable by ndusr_ut and music is not" needed
# two mounts. ext4 stores owner, group and mode per inode, so one filesystem
# expresses both -- and the partition table, the label dance and the
# is_untrusted_partition() guard all go away with it. See CARD_LAYOUT.
UNTRUSTED_MOUNT="${NEODCT_SDCARD_UNTRUSTED:-$MOUNT_POINT/$UNTRUSTED_NAME}"
STATE_DIR="${NEODCT_RUN_DIR:-/run/neodct}"
# Overridable so the host test suite can feed these in.
CMDLINE="${NEODCT_CMDLINE:-/proc/cmdline}"
MOUNTS="${NEODCT_MOUNTS:-/proc/mounts}"
# What the initramfs actually resolved, which beats the cmdline names.
BOOT_STATE="${NEODCT_BOOT_STATE:-/NeoDCT/User/.ndsys/verity_state.prop}"
STATE_FILE="$STATE_DIR/sdcard.prop"
LABEL=NEODCT
FOLDERS="wallpapers tones backup_db music update apps untrusted"

# The filesystems a NeoDCT card may be. ext4 first, and it is the only one
# do_format() writes: the others are here so an ext2/ext3 card somebody else
# made still mounts.
CARD_EXT_FSTYPES="ext4 ext3 ext2"

# ============ HOW THE PHONE KNOWS A CARD IS ITS OWN ============
#
# By looking at the MOUNTED FILESYSTEM, and deliberately not by asking blkid
# for the volume label.
#
# This gated the layout pass on `label_of` -- which is blkid -- and blkid is
# the reader this very file records as having returned NOTHING for a
# perfectly good FAT32 card, which is why try_mount asks the kernel whether
# something mounts instead of asking blkid what it is. Depending on it again,
# for the decision that applies the entire confinement, would mean a card
# whose label blkid could not read silently kept whatever modes it arrived
# with. On removable media that is the difference between the layout being
# enforced and merely being intended.
#
# The card is already mounted by the time this is asked, so the filesystem is
# right there. Three ways in, cheapest first:
#
#   FRESHLY_FORMATTED  do_format just made it; there is nothing to look at yet
#   the marker file     every card this phone formats gets one
#   the folder set      a card from an older NeoDCT, or one a person made on a
#                       computer by following the SD card help
#
# The label is still read, and still published, because the UI shows it. It
# just no longer decides anything.
CARD_MARKER=.neodct
FRESHLY_FORMATTED=""

card_is_ours() {
    [ -n "$FRESHLY_FORMATTED" ] && return 0
    [ -f "$MOUNT_POINT/$CARD_MARKER" ] && return 0
    [ -d "$MOUNT_POINT/wallpapers" ] && [ -d "$MOUNT_POINT/tones" ] &&
        [ -d "$MOUNT_POINT/music" ] && return 0
    return 1
}


# The users the two partitions are mounted for. Empty on an image built
# without BR2_ROOTFS_USERS_TABLES, and then the uid=/gid= options are simply
# left off and both mounts belong to root -- which is what every build before
# SECURITY-PLAN.md section 1 did.
CARD_USER="${NEODCT_CARD_USER:-ndusr}"
CARD_USER_UT="${NEODCT_CARD_USER_UT:-ndusr_ut}"

# ============ THE LAYOUT, WHICH IS THE WHOLE OF THE CONFINEMENT ============
#
# "<dir>:<mode>:<owner>:<group>", the empty name being the root of the card.
# Applied after every mount of a NeoDCT card, for the same reason S00userdata
# applies its own on every boot: the card is removable, it can be written on
# any PC, and the modes on it are therefore a claim rather than a fact until
# the phone has restated them.
#
#   .           0751  traverse but do not list, exactly as /NeoDCT/User does
#   apps        0755  installed apps. ndusr_ut may list and traverse; only
#                     ndusr may write, so an app cannot add or remove one
#   untrusted   0770  ndusr:ndusr_ut -- the ONE directory the untrusted set
#                     may write. Downloads land here and the browser and the
#                     media player keep their state here
#   the media   0750  the owner's music, wallpapers, tones, backups and
#                     update packages. ndusr_ut cannot read any of it, which
#                     on the old FAT card was impossible to express
#
# An individual app's directory is 0755 ndusr:ndusr (see apply_app_modes), so
# app.so is READ AND EXECUTE for the app and WRITE for nobody but the owner.
# Its data/ is the app's, and the core makes it -- an app that could create
# its own data directory could create siblings beside its code instead.
CARD_LAYOUT="
:0751:$CARD_USER:$CARD_USER
apps:0755:$CARD_USER:$CARD_USER
untrusted:0770:$CARD_USER:$CARD_USER_UT
music:0750:$CARD_USER:$CARD_USER
wallpapers:0750:$CARD_USER:$CARD_USER
tones:0750:$CARD_USER:$CARD_USER
backup_db:0750:$CARD_USER:$CARD_USER
update:0750:$CARD_USER:$CARD_USER
"

# The arrival side used to be a partition and needed a size: a quarter of the
# card, floored at 16 MiB and capped at 512 MiB. It is a directory now and
# takes whatever it takes, which is one of the smaller things ext4 bought.
# 1 MiB alignment, which is what every partitioner has used for fifteen years
# and what an SD card's erase blocks want.
ALIGN_SECTORS=$((1024 * 1024 / 512))

log() { echo "[sdcard] $*" >&2; }

# The path the arrival partition is mounted at, or empty. Set by
# mount_untrusted() and cleared by everything that tears a card down, so that
# write_state can publish it without every caller having to pass it.
UNTRUSTED_STATE=""

# What try_mount() last published. A card with two partitions is described by
# ONE record, and the arrival mount is only known after the media one is up --
# so the record has to be written twice, and the second write must not have to
# rediscover what the first one already knew. Re-deriving the fstype from
# /proc/mounts would be the obvious way and the wrong one: it answers a
# different question (what the kernel calls it) and answers nothing at all in
# the host tests, which would quietly blank the field.


# ============ AND WHY THE MODE IS SPELLED OUT ============
#
# This file is PUBLIC STATUS. nd_storage_card() in the ndusr core reads it on
# every card question the UI asks, and an unreadable state file is not an error
# there -- nd_props_parse_lenient() returns an empty map for every failure it
# can have, so EACCES and "no card in the slot" arrive at the UI as the same
# empty string and come out as the same sentence: "No memory card."
#
# Which is what happened. This script runs from three root contexts with three
# different umasks -- busybox init's 0022 at boot, udevd's 0022 on an
# insertion, and THE BROKER'S 0027 on a format, because nd_main.c forks the
# broker while still root and it inherits run_neodct.sh's umask, which nothing
# resets. So `cat > file` on the format path produced root:root 0640, and from
# the moment the owner accepted the reformat the phone could not see the card
# it had just made. It recovered on a reboot, because /run is a tmpfs and the
# boot scan rewrote the file under a different umask -- which is exactly the
# shape of report that is impossible to chase.
#
# This is the same bug the 0.5.8b keypad fix cured for keymap.json (nd_keymap.c
# and nd_path_give_to_dir_owner()). An explicit chmod is the cheap half of the
# cure and it belongs here, on the writer, because the writer is the only one
# who knows the file is not a secret.
write_state() {   # write_state STATE DEVICE FSTYPE LABEL
    mkdir -p "$STATE_DIR" 2>/dev/null
    chmod 0755 "$STATE_DIR" 2>/dev/null
    cat > "$STATE_FILE.new" <<EOF
state=$1
device=$2
fstype=$3
label=$4
untrusted=$UNTRUSTED_STATE
EOF
    # Before the rename, not after: mv is a rename(2) and the mode travels with
    # the inode, so a reader that catches the new name always sees 0644.
    chmod 0644 "$STATE_FILE.new" 2>/dev/null
    mv -f "$STATE_FILE.new" "$STATE_FILE"
}

# What the state file currently names as the card. Read back rather than
# remembered, because the process that wrote it is usually not this one: the
# boot scan, a udev handler and a format are three separate invocations.
published_device() {
    sed -n 's/^device=//p' "$STATE_FILE" 2>/dev/null | head -n1
}

# Devices the phone runs from; never treat these as removable.
#
# The kernel cmdline is only a hint: virtio-mmio devices are not enumerated
# in the order QEMU is handed them, and the first boot that got this wrong
# tried to mount the system image as an SD card. So three sources are used --
# what the initramfs recorded, the cmdline names, and the mount table -- plus
# a content check for the squashfs itself, which is mounted through
# /dev/mapper and so never appears in the mount table under its own name.
system_devices() {
    # What the initramfs resolved, if it left a record. This wins outright:
    # the cmdline names are a hint, and a wrong hint here is worse than no
    # hint at all -- neodct.sys=/dev/vda once named the SD card, so trusting
    # it excluded the card and left no candidate to mount.
    recorded=""
    SYSTEM_DEVICES_KNOWN=""
    for key in sys_device user_device; do
        value="$(sed -n "s/^$key=//p" "$BOOT_STATE" 2>/dev/null | head -n1)"
        if [ -n "$value" ]; then
            echo "$value"
            recorded=1
        fi
    done
    [ -n "$recorded" ] && { SYSTEM_DEVICES_KNOWN=1; return 0; }

    # No record (older initramfs, or the user partition is not mounted yet):
    # the names are all we have. The squashfs and mount-table checks in
    # is_reserved_device() still guard against them being wrong.
    for word in $(cat "$CMDLINE" 2>/dev/null); do
        case "$word" in
            neodct.sys=*)  echo "${word#neodct.sys=}"; SYSTEM_DEVICES_KNOWN=1 ;;
            neodct.user=*) echo "${word#neodct.user=}"; SYSTEM_DEVICES_KNOWN=1 ;;
        esac
    done
}

# ============ AND WHEN IT KNOWS NOTHING AT ALL ============
#
# system_devices() has three sources and can end up with none of them: no
# verity_state.prop (an image predating the immutable layout, or a user
# partition that is not mounted yet) and no neodct.sys=/neodct.user= on the
# cmdline. docs/HARDWARE_NOTES.md records exactly such a bootargs line for the
# pre-immutable Luckfox: `ubi.mtd=6 root=ubi0:rootfs rootfstype=ubifs`, and
# nothing in it names a device.
#
# When that happens is_system_device() returns false for EVERY device and the
# format guard collapses to "is it a squashfs" and "is it mounted somewhere
# else". Both are real checks; neither is the one the header treats as
# load-bearing. It is harmless on this board because the rootfs lives on ubi
# and only mmcblk/sd/vd names are ever offered as candidates -- but it is
# harmless by accident, and on a board where the system and the card share a
# controller (the SD_CARD board config) the accident stops holding.
#
# So say so, once, on the path where it matters. Not fatal: refusing to format
# anything on a phone whose initramfs is a version behind would be a worse
# answer than a degraded guard the owner is told about.
#
# The variable is set by system_devices(), which runs in a subshell whenever it
# is used in a substitution -- so this asks it again, in this shell, on purpose.
system_devices_known() {
    SYSTEM_DEVICES_KNOWN=""
    system_devices > /dev/null
    [ -n "$SYSTEM_DEVICES_KNOWN" ]
}

warn_if_guard_degraded() {
    system_devices_known && return 0
    log "WARNING: nothing records which devices the phone runs from -- no"
    log "  $BOOT_STATE and no neodct.sys= on the kernel cmdline. The format"
    log "  guard is down to the squashfs and mount-table checks; the by-name"
    log "  and by-parent-disk protection is NOT in force."
    return 0
}

# "hsqs" is the squashfs magic, and printable, so no od is needed.
is_squashfs() {
    [ -b "$1" ] || [ -f "$1" ] || return 1
    [ "$(dd if="$1" bs=4 count=1 2>/dev/null)" = "hsqs" ]
}

is_mounted() {
    cut -d' ' -f1 "$MOUNTS" 2>/dev/null | grep -qx "$1"
}

# True for anything that must never be touched as a removable card.
is_reserved_device() {
    is_system_device "$1" && return 0
    is_squashfs "$1" && return 0
    is_mounted "$1" && return 0
    return 1
}

# ============ AND THE SAME QUESTION, ASKED BY THE FORMATTER ============
#
# is_reserved_device() answers "is this something the phone must not touch",
# and one of its reasons is "it is mounted". That is right for candidates(),
# which is looking for a card to mount and has no business at one that already
# is. It is WRONG for do_format, and wrong in a way that made formatting a
# card impossible:
#
#   the owner opens Settings, the card is mounted -- that is what makes it a
#   card and not a slot -- and presses Format. is_mounted() says yes, and the
#   phone answers "refusing to format /dev/vda1: the phone is running from
#   it", which is not true and reads to the owner as
#
#       Formatting failed. The card may be write protected.
#
# So the only card that COULD be formatted was one that had failed to mount.
# A working card, and the legacy FAT card the UI itself offers to convert,
# both refused -- which took the FAT-to-ext4 migration with them.
#
# Found by running it on the phone. Nothing in the host suite could see it:
# the tests drive do_format against a loop device that nothing has mounted,
# which is the one state a real card is never in when somebody asks.
#
# The protection that matters is unchanged. The system and user partitions are
# still refused, by name and by parent disk; a squashfs is still refused; and
# anything mounted SOMEWHERE ELSE is still refused, which is what stops
# "format the card" reaching a filesystem the phone is actually using. Only
# the card at the phone's own card mountpoint is allowed through -- and
# do_format unmounts it four lines later.
mounted_outside_the_card() {   # mounted_outside_the_card DEV
    awk -v dev="$1" -v mnt="$MOUNT_POINT" -v ut="$UNTRUSTED_MOUNT" \
        '$1 == dev && $2 != mnt && $2 != ut { found = 1 } END { exit !found }' \
        "$MOUNTS" 2>/dev/null
}

is_reserved_for_format() {
    is_system_device "$1" && return 0
    is_squashfs "$1" && return 0
    mounted_outside_the_card "$1" && return 0
    return 1
}

# Whole disk a device belongs to: /dev/mmcblk0p1 -> /dev/mmcblk0,
# /dev/sda2 -> /dev/sda, /dev/vdc -> /dev/vdc.
#
# The two naming styles have to be handled separately: mmcblk and nvme names
# end in a digit while still being whole disks, and their partitions are
# suffixed "p<N>" rather than plain digits.
parent_disk() {
    name="$1"
    case "$name" in
        *mmcblk[0-9]p[0-9]*|*nvme[0-9]n[0-9]p[0-9]*|*loop[0-9]p[0-9]*)
            echo "${name%p*}"
            return
            ;;
        *mmcblk[0-9]|*nvme[0-9]n[0-9]|*loop[0-9])
            echo "$name"
            return
            ;;
    esac
    # sda1 / vdc2 style: strip the trailing partition number.
    while :; do
        case "$name" in
            *[0-9]) name="${name%?}" ;;
            *) break ;;
        esac
    done
    echo "$name"
}

# True for anything the phone is running from -- the named partitions and
# any sibling partition on the same physical disk.
is_system_device() {
    mine="$(parent_disk "$1")"
    for reserved in $(system_devices); do
        [ "$1" = "$reserved" ] && return 0
        [ "$mine" = "$(parent_disk "$reserved")" ] && return 0
    done
    return 1
}


partition_path() {   # partition_path DISK N
    case "${1##*/}" in
        mmcblk[0-9]*|nvme[0-9]*n[0-9]*|loop[0-9]*) echo "$1p$2" ;;
        *) echo "$1$2" ;;
    esac
}

# Size in 512-byte sectors.
#
# /sys/class/block rather than blockdev(1), which busybox is not built with
# here. A plain file is accepted too, so the host tests can drive do_format
# against an image the way they drive everything else.
device_sectors() {   # device_sectors DEV
    name="${1##*/}"
    if [ -r "${NEODCT_SYSFS_BLOCK:-/sys/class/block}/$name/size" ]; then
        cat "${NEODCT_SYSFS_BLOCK:-/sys/class/block}/$name/size"
        return 0
    fi
    if [ -f "$1" ]; then
        echo $(( $(wc -c < "$1") / 512 ))
        return 0
    fi
    return 1
}

# uid or gid of a name, or empty when the image has no such user. Empty is
# the honest answer and the callers leave the mount option off entirely
# rather than guessing a number -- the kernel's vfat driver takes numbers
# only, so a name would be silently ignored and the mount would belong to
# root while looking as though it did not.
name_uid() { id -u "$1" 2>/dev/null; }
name_gid() { id -g "$1" 2>/dev/null; }

fstype_of() {
    blkid "$1" 2>/dev/null | sed -n 's/.*[[:space:]]TYPE="\([^"]*\)".*/\1/p' \
        | head -n1
}

label_of() {
    blkid "$1" 2>/dev/null | sed -n 's/.*[[:space:]]LABEL="\([^"]*\)".*/\1/p' \
        | head -n1
}

# Candidate card devices: partitions first (a real card is usually
# partitioned), then whole disks formatted as a superfloppy.
#
# The globs are overridable, and that is not decoration. Which device is
# offered decides what gets mounted and, one function along, what the state
# file says -- and until now no host test could reach that decision at all,
# because the list was hardcoded at /dev. So the suite could only test the
# no-candidate case, and only on a machine that happens to have no /dev/sd*:
# on a developer's laptop the scan finds the workstation's own disk, fails to
# mount it, and the assertion about "no card" passes or fails depending on the
# hardware under the desk. Being able to point this at an empty directory is
# what makes "a card that will not mount" and "no card at all" two testable
# answers rather than one.
NEODCT_DEV_GLOBS="${NEODCT_DEV_GLOBS:-/dev/mmcblk*p[0-9] /dev/mmcblk[0-9] /dev/sd[a-z][0-9] /dev/sd[a-z] /dev/vd[a-z][0-9] /dev/vd[a-z]}"

candidates() {
    # Unquoted on purpose: this is where the globs expand.
    # shellcheck disable=SC2086
    for path in $NEODCT_DEV_GLOBS; do
        [ -b "$path" ] || continue
        is_reserved_device "$path" && continue
        echo "$path"
    done
}

# What the kernel says is mounted at a path, from the mount table.
mounted_fstype() {
    awk -v mnt="$1" '$2 == mnt {print $3; exit}' "$MOUNTS" 2>/dev/null
}

# Filesystems to try, in the order a card is likely to be. vfat first: that
# is what a NeoDCT card is.
CARD_FSTYPES="vfat exfat ext4 ext3 ext2"

# On every card mount, whatever is on it.
#
# A card is the one filesystem on this phone whose contents were chosen by
# whoever last held it, and it is mounted automatically on insertion by
# 60-neodct-sdcard.rules -- so "plug this in" is a code path an attacker with
# thirty seconds of physical access controls end to end. FAT cannot represent
# a setuid bit or a device node, so on a NeoDCT card these are defence in
# depth; on the ext card the helper will happily mount (CARD_FSTYPES) they are
# the only thing between a crafted card and a root shell.
#
# noexec is NOT here: it belongs on the part of the card things ARRIVE on, not
# on the one the owner deliberately copied media to. See SECURITY-PLAN.md
# section 1, "split by provenance, not by trust" -- a blanket noexec would also
# block emulator cores and nd-apprun's own dlopen() of an installed app's
# app.so, which lives on this filesystem.
#
# The arrival side gets it separately, from mount_untrusted_noexec(): a bind
# mount of untrusted/ onto itself, remounted noexec. That used to be free,
# because untrusted/ was a second FAT partition with its own mount options, and
# it silently stopped being true when the card became one ext4 filesystem and
# untrusted/ became an ordinary directory on it.
CARD_SAFETY_OPTS="nosuid,nodev"

# Who a FAT mount belongs to. Nothing without an owner: a FAT filesystem has
# no ownership of its own, so uid=/gid= are the ONLY way to say who may touch
# what on one, and leaving them off is what makes a card belong to whoever
# mounted it -- root, today.
#
# The masks are subtractive, and the two shapes are deliberate:
#
#   media side    dmask=0026 -> directories 0751, fmask=0137 -> files 0640.
#                 0751 is the same "traverse but do not list" trick
#                 /NeoDCT/User uses: ndusr_ut can walk through to reach the
#                 arrival mount below, and `ls` of the owner's music is
#                 EACCES. Files give it nothing at all.
#
#   arrival side  uid=ndusr_ut so the browser can WRITE, gid=ndusr so the
#                 core can READ. dmask=0027 -> 0750, fmask=0137 -> 0640.
#
# That second gid is a deliberate departure from the plan's table, which has
# gid=ndusr_ut. It has to be: the plan's own workflow is that installing
# something downloaded is "an explicit copy from p2 to p1 that the owner
# performs through the UI", and the UI is ndusr. A group it cannot read is a
# download nobody can ever do anything with.
card_owner_opts() {   # card_owner_opts OWNER GROUP
    _uid="$(name_uid "$1")"
    _gid="$(name_gid "$2")"
    # No such user in this image: say nothing rather than guess a number.
    [ -n "$_uid" ] && [ -n "$_gid" ] || return 0
    echo "uid=$_uid,gid=$_gid"
}

CARD_MEDIA_MASKS="dmask=0026,fmask=0137"
CARD_ARRIVAL_MASKS="dmask=0027,fmask=0137"

try_mount() {   # try_mount DEV
    mkdir -p "$MOUNT_POINT" 2>/dev/null

    # Ask the kernel, not blkid. busybox's blkid has far fewer filesystem
    # probers than util-linux's and reported *nothing* for a plain mkfs.vfat
    # card, so a perfectly good card was announced as having "no filesystem we
    # can read". Whether it mounts is the only question that matters.
    for fstype in $CARD_FSTYPES; do
        case "$fstype" in
            # utf8 keeps accented filenames intact; flush writes through, so
            # pulling the card loses less. Both are FAT-only -- passing them
            # to ext4 makes the mount fail.
            vfat|msdos|exfat) options="rw,noatime,utf8,flush" ;;
            *)                options="rw,noatime" ;;
        esac
        options="$options,$CARD_SAFETY_OPTS"

        # ============ NO uid=/gid=/fmask=/dmask= ON AN EXT CARD ============
        #
        # An ext filesystem carries real ownership, so forcing uid= on one
        # would make every file on it belong to ndusr no matter who wrote it
        # -- and the kernel rejects the option there anyway. The modes come
        # from apply_layout() below instead, which is a stronger thing: it can
        # say something different about apps/ than about music/, which is the
        # whole reason the card is ext4 now.
        #
        # A FAT card still gets the old treatment. It is either somebody
        # else's card or a NeoDCT card from before 0.5.0b, and in both cases
        # it is read-mostly media with no apps on it.
        case "$fstype" in
            vfat|msdos|exfat)
                owner="$(card_owner_opts "$CARD_USER" "$CARD_USER")"
                [ -n "$owner" ] && options="$options,$owner,$CARD_MEDIA_MASKS"
                ;;
        esac
        if mount -t "$fstype" -o "$options" "$1" "$MOUNT_POINT" 2>/dev/null; then
            after_mount "$1" "$fstype"
            return 0
        fi
    done

    # Last resort: let the kernel pick from its own probe list.
    if mount -o "rw,noatime,$CARD_SAFETY_OPTS" "$1" "$MOUNT_POINT" 2>/dev/null; then
        fstype="$(mounted_fstype "$MOUNT_POINT")"
        after_mount "$1" "${fstype:-unknown}"
        return 0
    fi

    write_state unmountable "$1" "$(fstype_of "$1")" "$(label_of "$1")"
    log "$1 has no filesystem we can mount"
    return 1
}

# True when this filesystem can express per-file ownership, which is the whole
# question the card's layout turns on.
is_ext_fstype() {   # is_ext_fstype FSTYPE
    for _t in $CARD_EXT_FSTYPES; do
        [ "$1" = "$_t" ] && return 0
    done
    return 1
}

# ============ RESTATED ON EVERY MOUNT, NOT SET ONCE AT FORMAT ============
#
# The card is removable and it is now ext4, which means the owner can mount it
# on any Linux PC and chmod 0777 the lot -- deliberately or by copying a tree
# across with the wrong umask. Modes that were correct when the card was
# formatted are therefore a claim about the past, not a fact about the
# present, and the confinement rests on them.
#
# So the phone reasserts the layout every time it mounts one of its own cards,
# exactly as S00userdata reasserts the user partition on every boot. It is
# cheap: eight chmod/chown pairs on directories that already exist.
#
# Only on cards that are OURS -- ext, and labelled NEODCT. Chowning a
# stranger's card would be the phone quietly taking ownership of somebody's
# photographs.
apply_layout() {
    printf '%s\n' "$CARD_LAYOUT" | while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        name="${entry%%:*}"; rest="${entry#*:}"
        mode="${rest%%:*}"; rest="${rest#*:}"
        owner="${rest%%:*}"; group="${rest#*:}"
        path="$MOUNT_POINT/$name"
        [ -z "$name" ] && path="$MOUNT_POINT"
        [ -d "$path" ] || continue
        chown "$owner:$group" "$path" 2>/dev/null
        chmod "$mode" "$path" 2>/dev/null
    done

    # Every installed app, one level down. The directory is the owner's and
    # the app.so inside it is read-only to the app -- that is what stops an
    # app rewriting its own code, and it is the property PentestPersist
    # probes for.
    #
    # ============ AND data/, WHICH IS MADE HERE AND NOT BY THE APP ========
    #
    # Two reasons it is root's job and not the core's:
    #
    #   1. It has to belong to ndusr_ut, and the CORE IS ndusr. Changing a
    #      file's owner to somebody else needs CAP_CHOWN, which is exactly the
    #      privilege the core gave up. This script runs from udev and
    #      S12sdcard, as root, and can.
    #   2. An app that could create its own data directory could create
    #      SIBLINGS instead -- another .so next to the one the launcher
    #      loads. Making it here means the app only ever writes inside a
    #      directory it did not make.
    #
    # ndusr:ndusr_ut 0770, so the app writes and the core can read it back to
    # uninstall. Group-writable means every untrusted app can reach every
    # other's data, because they are all ndusr_ut -- one uid, one principal.
    # That is the honest state today and the shape does not have to change to
    # fix it: a uid per installed app turns this same directory into a real
    # boundary with no rearranging.
    #
    # data/'s CONTENTS are NOT touched. It is the app's, and a blanket chmod on
    # every mount would take it back.
    #
    # ============ AND WHY THE REST OF IT IS RECURSIVE NOW ============
    #
    # This walked one level and looked only at regular files:
    #
    #     for f in "$appdir"*; do [ -f "$f" ] || continue; ... done
    #
    # so a SUBDIRECTORY of an app was skipped by the `[ -f ]` and everything
    # inside it was never reached. That is fine for a .nap install, where
    # nd_nap.c writes every file itself as ndusr. It is not fine for the way
    # the data most likely to break actually arrives: a PSX disc image is 600
    # MB and nd_nap.h caps a packaged file at 64 MiB, so the documented route
    # for BIOS dumps and games is copying folders onto the card from a Linux
    # PC. The card is ext4 and carries real numeric ownership (there is
    # deliberately no uid=/gid= on an ext mount, see try_mount), so those
    # folders arrive owned by whoever wrote them -- root:root under `sudo cp`,
    # a stranger's uid otherwise, 0700 out of a tar that preserved modes.
    #
    # The app is ndusr_ut. It can traverse into the subdirectory's NAME,
    # because the app directory above is forced to 0755, and then gets EACCES
    # on the contents -- an emulator that cannot read its own games, with no
    # message. The same shape catches anything the engineering Fetch app
    # downloads: Fetch runs as root under run_neodct.sh's umask 0027, so its
    # files land 0640 root:root and its directories 0750.
    #
    # find rather than a recursive shell loop: busybox has -xdev, -prune and
    # -exec + here (see the busybox fragment), it is one process instead of one
    # per file, and -prune is how data/ stays the app's.
    for appdir in "$MOUNT_POINT/apps"/*/; do
        [ -d "$appdir" ] || continue
        # Without the trailing slash. The glob above produces "<app>/", and
        # `-path "<app>//data"` matches nothing that find ever prints -- so the
        # prune silently misses and the app's own save files get chmod 0644.
        app="${appdir%/}"
        chown "$CARD_USER:$CARD_USER" "$app" 2>/dev/null
        chmod 0755 "$app" 2>/dev/null
        find "$app" -xdev -path "$app/data" -prune -o \
            \( -type d -exec chown "$CARD_USER:$CARD_USER" {} + \
                     -exec chmod 0755 {} + \) -o \
            \( -type f -exec chown "$CARD_USER:$CARD_USER" {} + \
                     -exec chmod 0644 {} + \) 2>/dev/null
        mkdir -p "$app/data" 2>/dev/null
        chown "$CARD_USER:$CARD_USER_UT" "$app/data" 2>/dev/null
        chmod 0770 "$app/data" 2>/dev/null
    done

    # ============ AND THE MEDIA FOLDERS, OWNER ONLY ============
    #
    # The media directories get their own mode from the table above and their
    # contents got nothing at all, which has the same consequence one level
    # down: a track the root Fetch app downloaded into music/ is 0640
    # root:root inside a 0750 ndusr:ndusr directory, so MusicPlayer -- ndusr --
    # cannot open a file the phone itself put there.
    #
    # OWNER ONLY, and no chmod. The mode of a media file is nobody's business:
    # a card is where the owner puts their own music, and restating 0644 across
    # a few thousand files on every insertion is both slow and rude. Ownership
    # is what the confinement actually rests on, and `! -user` means the walk
    # costs one stat per file and a chown only for the ones that are wrong --
    # which on a card the phone has already seen is none of them.
    for folder in music tones wallpapers backup_db update; do
        [ -d "$MOUNT_POINT/$folder" ] || continue
        find "$MOUNT_POINT/$folder" -xdev ! -user "$CARD_USER" \
            -exec chown "$CARD_USER:$CARD_USER" {} + 2>/dev/null
    done
}

# ============ THE ARRIVAL AREA IS noexec, AND IT HAD STOPPED BEING ============
#
# SECURITY-PLAN.md section 1 splits the card by PROVENANCE: what the owner
# deliberately copied on, and what merely arrived. The second half is
# untrusted/, and the property that made the split mean something was that a
# downloaded binary could not be RUN without the owner first copying it across
# -- the deliberate act the design wants.
#
# That property was carried by the mount options, because untrusted/ was a
# second FAT partition with its own mount. When the card became one ext4
# filesystem it became an ordinary directory, and it inherited the media
# partition's options -- which by design do NOT include noexec, because a
# blanket noexec on the card would also stop nd-apprun dlopen()ing an installed
# app's app.so. So the arrival area silently went back to being executable and
# dlopen-able by ndusr_ut, in place, with no copy required. Nothing failed;
# the guarantee just stopped being one, and the selftest check that would have
# caught it was replaced by a mode-and-ownership check in the same commit.
#
# A bind mount of the directory onto itself, remounted noexec, restores it
# without touching the rest of the card: one filesystem, two sets of options.
# nosuid and nodev are repeated because MS_REMOUNT replaces the flag set for
# this mount rather than adding to it.
#
# Not fatal when it fails. The alternative -- refusing to publish untrusted=,
# so no download has anywhere to land -- turns a hardening step into a
# functional regression on a kernel we cannot test from here, and the phone is
# then no worse off than it is today, only noisier about it. The log line is
# the point: nd-selftest can assert the property, and a boot where it did not
# take says so on the console.
mount_untrusted_noexec() {
    [ -d "$UNTRUSTED_MOUNT" ] || return 1
    # Already done -- a re-scan of a mounted card must not stack a second one.
    awk -v m="$UNTRUSTED_MOUNT" '$2 == m { found = 1 } END { exit !found }' \
        "$MOUNTS" 2>/dev/null && return 0

    mount -o bind "$UNTRUSTED_MOUNT" "$UNTRUSTED_MOUNT" 2>/dev/null || return 1
    if ! mount -o remount,bind,nosuid,nodev,noexec "$UNTRUSTED_MOUNT" 2>/dev/null; then
        # A bind that took and a remount that did not is worse than neither:
        # the directory is now a mount point with the media partition's
        # options, which is exactly what it was, plus an entry in the table.
        umount -l "$UNTRUSTED_MOUNT" 2>/dev/null
        return 1
    fi
    return 0
}

# ============ CAN THE CORE ACTUALLY READ THIS CARD? ============
#
# Only ever asked about a card that is NOT ours. One of ours has just had
# apply_layout() restate every mode and owner on it, so the answer is yes by
# construction; a stranger's card is mounted with no uid=/gid= at all (an ext
# filesystem carries its own ownership and the phone must not overwrite it,
# see try_mount) and therefore arrives exactly as some other computer left it.
#
# mkfs.ext4 leaves the root inode root:root 0755, which anybody can read. A
# card restored from a tar with modes, copied into with a strict umask, or
# formatted inside somebody's home-directory tooling just as easily arrives
# 0700 root:root or 0770 alice:alice -- perfectly good cards that the core
# cannot open. The core is ndusr and everything downstream of the mount is
# ndusr: listing the card, reading a wallpaper off it, counting its free
# space. So "is this card usable" has exactly one meaningful reading, and it
# is not root's.
#
# Asked, not deduced. Reading the mode bits would be this script reimplementing
# the kernel's decision with less information than the kernel has -- ownership,
# the supplementary groups ndusr is in, an ACL the other computer may have left
# on the directory -- to answer a question it can simply put to the kernel as
# the user in question. su(1) costs one fork on a stranger's card and nothing
# at all on ours.
#
# chdir AND readdir, because the two failures are different and the UI needs
# both: without +x the core cannot open a file on the card even by name,
# without +r it cannot find out what is on it.
core_can_read_card() {   # core_can_read_card MOUNTPOINT
    # No users table in this image, or we are not root and so cannot ask on
    # anyone else's behalf -- the host test suite is both. Everything runs as
    # root there, root ignores the modes, and yes is the honest answer.
    [ -n "$CARD_USER" ] || return 0
    [ "$(id -u 2>/dev/null)" = "0" ] || return 0
    id "$CARD_USER" > /dev/null 2>&1 || return 0

    # The path goes in as an ARGUMENT, not spliced into the command: it comes
    # from NEODCT_SDCARD_MOUNT and this is a root shell handing work to another
    # user. -s /bin/sh because ndusr's login shell is /bin/false by design.
    su -s /bin/sh "$CARD_USER" -c 'cd -- "$1" && ls -A . > /dev/null' \
        sdcard-probe "$1" > /dev/null 2>&1
}

# What happens after any successful mount: decide what KIND of card this is,
# fix it up if it is ours, and publish one record describing all of it.
after_mount() {   # after_mount DEV FSTYPE
    UNTRUSTED_STATE=""

    if ! is_ext_fstype "$2"; then
        # ============ A CARD FROM BEFORE 0.5.0b, OR SOMEBODY ELSE'S ========
        #
        # FAT cannot express the layout above, so this card can hold media and
        # nothing else: no apps, and no arrival directory, because a directory
        # ndusr_ut may write cannot be created on a filesystem with no notion
        # of who owns what. `untrusted=` stays empty and the browser has
        # nowhere to download to, which is the correct answer rather than a
        # degraded one.
        #
        # `legacy` rather than `mounted` so the UI can say so and offer to
        # format. That is a destructive offer and it is the owner's to accept:
        # the phone will not reformat a card it found.
        if card_is_ours; then
            log "$1 is a NeoDCT card in the old FAT format; it can hold media but not apps"
            write_state legacy "$1" "$2" "$(label_of "$1")"
        else
            log "mounted $1 ($2) at $MOUNT_POINT"
            write_state mounted "$1" "$2" "$(label_of "$1")"
        fi
        return 0
    fi

    if card_is_ours; then
        for folder in $FOLDERS; do
            mkdir -p "$MOUNT_POINT/$folder" 2>/dev/null
        done
        # Written before the layout pass so the pass can set its mode, and so
        # the NEXT mount recognises the card without needing the folder set --
        # which an owner can delete.
        : > "$MOUNT_POINT/$CARD_MARKER" 2>/dev/null
        chown "$CARD_USER:$CARD_USER" "$MOUNT_POINT/$CARD_MARKER" 2>/dev/null
        chmod 0644 "$MOUNT_POINT/$CARD_MARKER" 2>/dev/null
        apply_layout
        if ! mount_untrusted_noexec; then
            log "WARNING: $UNTRUSTED_MOUNT is NOT noexec. A downloaded binary"
            log "  can be run or dlopened from it in place, which the card"
            log "  layout is supposed to make impossible."
        fi
        UNTRUSTED_STATE="$UNTRUSTED_MOUNT"
    elif ! core_can_read_card "$MOUNT_POINT"; then
        # ============ A STRANGER'S CARD, AND IT SAYS SO ============
        #
        # Mounted, untouched, and unreadable by the user the UI runs as. That
        # is a real state of the world and it needs a word of its own: called
        # `mounted`, it reaches nd_storage_card() as a card whose folders
        # cannot be found, and the owner is told their card may be locked or
        # damaged -- for a card that is neither, that their computer will mount
        # perfectly, and that `setup` would hand over in one step if the UI
        # knew to offer.
        #
        # device= and fstype= are published like any other mounted card, so the
        # offer has something to name. untrusted= stays empty: nothing on this
        # card belongs to ndusr_ut and a download must not be written to it.
        log "$1 ($2) is mounted at $MOUNT_POINT but $CARD_USER cannot read it"
        log "  a card from another computer -- the setup verb takes ownership of one"
        write_state foreign "$1" "$2" "$(label_of "$1")"
        return 0
    fi
    log "mounted $1 ($2) at $MOUNT_POINT"
    write_state mounted "$1" "$2" "$(label_of "$1")"
    return 0
}

mount_share() {
    # QEMU convenience: a host folder exported over virtiofs. Tagged on the
    # kernel cmdline by neodct/tools/run_qemu.sh.
    for word in $(cat "$CMDLINE" 2>/dev/null); do
        case "$word" in
            neodct.sdshare=*)
                tag="${word#neodct.sdshare=}"
                mkdir -p "$MOUNT_POINT" 2>/dev/null
                if mount -t virtiofs -o "$CARD_SAFETY_OPTS" "$tag" \
                        "$MOUNT_POINT" 2>/dev/null; then
                    write_state share "$tag" virtiofs ""
                    log "mounted virtiofs share $tag at $MOUNT_POINT"
                    return 0
                fi
                log "virtiofs share $tag failed to mount"
                ;;
        esac
    done
    return 1
}

# What the mount table says is mounted AT a path, by device.
mounted_device() {   # mounted_device MOUNTPOINT
    awk -v mnt="$1" '$2 == mnt {print $1; exit}' "$MOUNTS" 2>/dev/null
}

do_scan() {
    # A format is a sequence of destructive steps on a device that is
    # deliberately unmounted in the middle of them, and partprobe fires a
    # remove and an add for every partition on the disk while it is happening.
    # Automounting halfway through one is how a card gets mounted while mke2fs
    # is still writing it -- mkfs_ext4 passes -F, so mke2fs will not refuse --
    # and how do_format's own closing mount ends up stacked on top of somebody
    # else's. Stand well back.
    if formatting_in_flight; then
        log "scan: a format is in progress; leaving the card alone"
        return 0
    fi

    if mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
        # ============ ALREADY MOUNTED IS NOT ALREADY DESCRIBED ============
        #
        # This used to `return 0` and publish nothing, on the reasoning that a
        # mounted card has nothing left to do. That reasoning has a hole in it:
        # the record can be WRONG while the card is mounted. partprobe's remove
        # uevent lands after a format has finished and republishes `absent`
        # over a perfectly good card; from then on every later scan took this
        # branch, wrote nothing, and the card stayed invisible until a reboot.
        #
        # So restate it. after_mount() is the function that knows how to
        # describe a mounted card and it is idempotent -- it makes folders that
        # exist and chowns files that are already right -- so the honest fix is
        # to run it rather than to invent a second describer that can disagree
        # with the first.
        _dev="$(mounted_device "$MOUNT_POINT")"
        _fs="$(mounted_fstype "$MOUNT_POINT")"
        if [ "$_fs" = virtiofs ]; then
            # The QEMU host share. after_mount() would classify it by
            # filesystem and call it a legacy FAT card, which is a worse
            # answer than the one mount_share() already knew.
            UNTRUSTED_STATE=""
            write_state share "$_dev" virtiofs ""
        elif [ -n "$_dev" ] && [ -n "$_fs" ]; then
            after_mount "$_dev" "$_fs"
        fi
        return 0
    fi
    mount_share && return 0

    # ============ AND WHY THE LOOP REMEMBERS WHAT IT SAW ============
    #
    # try_mount() published `unmountable` for a card that is present and whose
    # filesystem we cannot read, and then the loop moved on and the line below
    # overwrote it with `absent`. On real hardware there are ALWAYS at least
    # two candidates for one card -- candidates() offers /dev/mmcblk1p1 from
    # its first glob and /dev/mmcblk1 from its second -- so a single failing
    # card produced two unmountable writes and one absent, every time, and
    # `state=unmountable` became unreachable from the scan path entirely.
    #
    # The cost of that is a dead end in the UI, not a cosmetic one. ABSENT
    # deliberately blanks device=, Settings sends ABSENT straight to "No memory
    # card." and returns before it can offer to format, and format_card()
    # refuses anyway because there is no device to point at. So the one
    # diagnostic the owner needed -- there IS a card here and I cannot read its
    # filesystem -- was thrown away, and with it the only way forward.
    _seen=""
    for device in $(candidates); do
        try_mount "$device" && return 0
        _seen="$device"
    done
    if [ -n "$_seen" ]; then
        log "no candidate mounted; $_seen is present and unreadable"
        write_state unmountable "$_seen" "$(fstype_of "$_seen")" "$(label_of "$_seen")"
        return 0
    fi
    write_state absent "" "" ""
    return 0
}

# ============ THE LAYOUT, ON REQUEST ============
#
# apply_layout() runs on every mount, and that covered every app on the card
# until the phone could INSTALL one. An install happens while the card is
# mounted, as ndusr, and ndusr can put every file of the app in place except
# one: data/ has to belong to ndusr_ut, and giving a directory to somebody
# else needs CAP_CHOWN, which the core gave up. So after an install the core
# asks for this, through the broker, as root -- the same pass a mount does,
# a second time.
#
# It takes NO ARGUMENT, on purpose. The card it lays out is the one at the
# phone's own mountpoint, and whether that card is ours is decided here by
# card_is_ours(), exactly as after_mount() decides it. A verb that took a
# path would be a root chown at a path the caller chose, which is the shape
# nd_broker.h exists to refuse.
#
# Exit 1 when there is nothing to lay out -- no card, a foreign card, a FAT
# card -- so the caller can tell "done" from "not applicable", and never
# touches anything in either case.
do_layout() {
    fstype="$(mounted_fstype "$MOUNT_POINT")"
    if [ -z "$fstype" ]; then
        log "layout: nothing is mounted at $MOUNT_POINT"
        return 1
    fi
    if ! is_ext_fstype "$fstype"; then
        log "layout: $fstype cannot hold the layout"
        return 1
    fi
    if ! card_is_ours; then
        log "layout: the card at $MOUNT_POINT is not a NeoDCT card"
        return 1
    fi
    for folder in $FOLDERS; do
        mkdir -p "$MOUNT_POINT/$folder" 2>/dev/null
    done
    apply_layout
    # A .nap install can create untrusted/ for the first time, and the bind
    # mount that makes it noexec can only be laid over a directory that exists.
    mount_untrusted_noexec || \
        log "WARNING: $UNTRUSTED_MOUNT is NOT noexec"
    log "layout restated on $MOUNT_POINT"
    return 0
}

# ============ REMOVE MEANS *THIS* CARD, NOT ANY BLOCK DEVICE ============
#
# This took the device name the udev rule passes and threw it away: it
# unmounted $MOUNT_POINT and wrote `state=absent` for ANY partition removal
# anywhere on the phone. 60-neodct-sdcard.rules matches every block partition,
# so that is a broad promise to keep.
#
# It became load-bearing when do_format learned to write a partition table.
# partprobe issues BLKRRPART, the kernel deletes and re-adds every partition on
# the disk, and udev queues a `remove` for the card's own partition -- which
# lands, asynchronously, while the format that caused it is still running.
# Scheduled late enough it arrives AFTER do_format has mounted the new
# filesystem and published `mounted`, unmounts it, and publishes `absent` over
# the top. The owner is told "Card formatted and ready." and from that moment
# the phone has no card: do_scan's already-mounted branch used to publish
# nothing, and format_card() refuses to try again because ABSENT blanks the
# device. Only a reboot or physically pulling the card recovered it.
#
# So: honour the argument. Act only when the device named is the one we
# published, or the disk that device belongs to; anything else is a no-op with
# a line saying so. No argument at all still means "tear the card down" --
# that is S12sdcard's `stop`, a deliberate teardown by somebody who knows there
# is only one card.
#
# The lock in the dispatcher is the other half: with it, this cannot run in the
# middle of a format at all, only before or after.
do_remove() {   # do_remove [DEVNAME]
    _who="${1:-}"
    _mounted="$(mounted_device "$MOUNT_POINT")"

    if [ -n "$_who" ]; then
        if formatting_in_flight; then
            log "remove $_who: a format is in progress; ignoring"
            return 0
        fi
        # udev passes %k, a kernel name with no /dev prefix.
        case "$_who" in
            /*) _dev="$_who" ;;
            *)  _dev="/dev/$_who" ;;
        esac
        # ============ AND IS IT ACTUALLY GONE? ============
        #
        # A `remove` uevent means the kernel destroyed that device. It does NOT
        # mean the card left the slot: BLKRRPART destroys and immediately
        # recreates every partition on the disk, so a format fires a remove and
        # an add at itself for its own card. The lock keeps those handlers out
        # of the middle of the format; it cannot keep them from running the
        # moment it is released, and by then their decision -- "the card is
        # gone" -- is several seconds out of date and wrong.
        #
        # devtmpfs unlinks the node before the uevent is delivered, so for a
        # card that really was pulled the node is not there and stays not
        # there. For a rescan it is back by now. Asking the filesystem is
        # therefore the difference between the two, and it needs no timer.
        if [ -b "$_dev" ]; then
            log "remove $_dev: the node is still there; not a removal"
            return 0
        fi
        _ours="${_mounted:-$(published_device)}"
        if [ -z "$_ours" ]; then
            log "remove $_dev: no card is recorded; nothing to do"
            return 0
        fi
        if [ "$_dev" != "$_ours" ] && \
           [ "$(parent_disk "$_dev")" != "$(parent_disk "$_ours")" ]; then
            log "remove $_dev: not the card ($_ours); ignoring"
            return 0
        fi
    fi

    # Inner mount first. `umount -l` on the parent would detach the subtree
    # and leave the arrival filesystem attached to nothing, which is a card
    # that cannot be re-inserted without a reboot.
    umount -l "$UNTRUSTED_MOUNT" 2>/dev/null
    umount -l "$MOUNT_POINT" 2>/dev/null
    UNTRUSTED_STATE=""
    write_state absent "" "" ""
    log "card removed"
}

# ============ SETTING UP A CARD THE PHONE DID NOT MAKE ============
#
# An ext card somebody formatted on a PC mounts, has none of the folders, and
# is reported NEEDS_SETUP. Settings offers "Set up", and until now that offer
# called nd_storage_setup_folders() -- plain mkdir, in the core's own process.
# The core is ndusr and the card's root directory is root:root 0755 as mkfs.ext4
# left it, so the mkdir is EACCES and the owner is told "Could not write to the
# card. It may be locked or damaged", which is neither. It worked in 0.4.x
# because the core was root; the privilege drop invalidated the affordance and
# nothing noticed.
#
# It is a verb here for the same reason `layout` is one: creating the folders
# is not the hard part, giving untrusted/ and each app's data/ to ndusr_ut is,
# and changing a file's owner needs CAP_CHOWN. Like `layout` it takes NO
# ARGUMENT -- the card it sets up is the one at the phone's own mountpoint --
# so there is no path for a caller to choose.
#
# It does take ownership of a stranger's card, which after_mount() deliberately
# refuses to do uninvited. That is the whole point of it being a verb: the
# owner asked.
do_setup() {
    fstype="$(mounted_fstype "$MOUNT_POINT")"
    if [ -z "$fstype" ]; then
        log "setup: nothing is mounted at $MOUNT_POINT"
        return 1
    fi
    if ! is_ext_fstype "$fstype"; then
        log "setup: $fstype cannot hold the layout"
        return 1
    fi
    for folder in $FOLDERS; do
        mkdir -p "$MOUNT_POINT/$folder" 2>/dev/null
    done
    # The marker, so the next mount recognises the card without the folder set
    # -- which an owner can delete.
    : > "$MOUNT_POINT/$CARD_MARKER" 2>/dev/null
    chown "$CARD_USER:$CARD_USER" "$MOUNT_POINT/$CARD_MARKER" 2>/dev/null
    chmod 0644 "$MOUNT_POINT/$CARD_MARKER" 2>/dev/null
    if ! card_is_ours; then
        log "setup: could not write the marker to $MOUNT_POINT"
        return 1
    fi
    apply_layout
    mount_untrusted_noexec || \
        log "WARNING: $UNTRUSTED_MOUNT is NOT noexec after setup"
    UNTRUSTED_STATE="$UNTRUSTED_MOUNT"
    write_state mounted "$(mounted_device "$MOUNT_POINT")" "$fstype" \
        "$(label_of "$(mounted_device "$MOUNT_POINT")")"
    log "set up $MOUNT_POINT as a NeoDCT card"
    return 0
}

# --- laying down a partition table, by hand -------------------------------
#
# There is no sfdisk, no cfdisk and no parted in this image, and busybox's
# fdisk has no batch mode -- it is an interactive program and nothing else.
# The two ways forward are piping a keystroke sequence into it and hoping its
# prompts never change, or writing the 446th to 512th bytes of the device
# ourselves. The second is 66 bytes of a format that has not changed since
# 1983, it is deterministic, and it is testable on the host against an image
# file. So: this.
#
# An MBR partition entry is sixteen bytes:
#
#   +0   status              0x00, not bootable -- nothing boots off a card
#   +1   first sector CHS    0xFE 0xFF 0xFF, the "look at the LBA instead"
#                            placeholder every partitioner writes now
#   +4   type                0x0C, FAT32 with LBA addressing
#   +5   last sector CHS     same placeholder
#   +8   first LBA           4 bytes, little-endian
#   +12  sector count        4 bytes, little-endian
#
# and the table is four of those at offset 446, then 0x55 0xAA at 510.

# A 32-bit little-endian integer, as four bytes.
#
# Two printfs, and the second one is not redundant. `printf '\%03o' 12` does
# not emit byte 014 -- \% is not an escape sequence, so printf prints a
# backslash and then formats the number, giving the five CHARACTERS "\014".
# The first printf below builds exactly that text; the second interprets it.
# Getting this wrong produces a partition table made of ASCII, which is
# precisely as broken as it sounds and precisely as quiet.
#
# The NUL bytes survive because it is the TEXT "\000" that passes through the
# command substitution -- a real NUL would not.
le32() {   # le32 VALUE
    _v="$1"
    _esc="$(printf '\\%03o\\%03o\\%03o\\%03o' \
        $((_v & 255)) $(((_v >> 8) & 255)) $(((_v >> 16) & 255)) \
        $(((_v >> 24) & 255)))"
    printf "$_esc"
}

# One partition entry, sixteen bytes.
#
# Type 0x83, Linux. It was 0x0c (FAT32 LBA) when the card was FAT, and the
# byte is not decoration: a PC that reads the table decides what to try
# mounting from it, and an ext4 filesystem inside a partition claiming to be
# FAT32 is a card that a desktop offers to repair.
mbr_entry() {   # mbr_entry FIRST-LBA SECTORS
    printf '\000\376\377\377\203\376\377\377'
    le32 "$1"
    le32 "$2"
}

# Round down to the alignment. Every partition starts and ends on a 1 MiB
# boundary, which is what SD card erase blocks want and what stops a card
# performing like a floppy.
align_down() { echo $(( ($1 / ALIGN_SECTORS) * ALIGN_SECTORS )); }

# write_mbr DISK P1-START P1-SECTORS
#
# One entry now. The second was the arrival partition, which ext4 turned into
# a directory -- see CARD_LAYOUT.
#
# Assembled in a temp file and copied, rather than piped straight at the
# card. Two reasons, and the first one is not a preference:
#
#   dd reads a pipe with one read() per block, and a read() from a pipe
#   returns whatever happens to be in it. `dd bs=512 count=1` on the far end
#   of this therefore takes the first 446 bytes and stops -- which is a
#   partition table with no partitions in it, written to a card, silently.
#   That is exactly what the first version of this did.
#
#   And the length can be checked before anything touches the device. 512
#   bytes or nothing is a cheap thing to insist on in the one function here
#   that can make a card unreadable.
write_mbr() {
    _tmp="${TMPDIR:-/tmp}/.neodct-mbr.$$"

    {
        # 446 bytes of nothing where boot code would be, because nothing
        # boots off a card.
        dd if=/dev/zero bs=446 count=1 2>/dev/null
        mbr_entry "$2" "$3"
        # Entries two, three and four, empty.
        dd if=/dev/zero bs=48 count=1 2>/dev/null
        printf '\125\252'
    } > "$_tmp" 2>/dev/null

    if [ "$(wc -c < "$_tmp" 2>/dev/null)" != "512" ]; then
        rm -f "$_tmp"
        return 1
    fi
    dd if="$_tmp" of="$1" bs=512 count=1 conv=notrunc 2>/dev/null
    _rc=$?
    rm -f "$_tmp"
    return $_rc
}

# Ask the kernel to look at the table again. Without this the partition nodes
# for a freshly written table do not exist and the mkfs below has nothing to
# write to.
reread_partitions() {   # reread_partitions DISK
    sync
    partprobe "$1" > /dev/null 2>&1 || return 1
    # udev has to catch up before the nodes appear. Not a race worth being
    # clever about: this runs once, from a menu, with a person waiting.
    _tries=0
    while [ "$_tries" -lt 50 ]; do
        # Partition ONE, and only one. This waited for p2 as well, which after
        # the move to a single ext4 partition is a device node that never
        # appears -- so every format would have run the table out and then
        # reported that the kernel had not picked it up.
        [ -b "$(partition_path "$1" 1)" ] && \
            return 0
        sleep 0.1
        _tries=$((_tries + 1))
    done
    return 1
}

# The formatter, and the only filesystem the phone ever writes to a card.
#
# It was two FAT partitions. ext4 is what makes the layout above expressible
# at all -- see CARD_LAYOUT -- so a card the phone formats is one ext4
# partition and the ownership does the work the partition table used to.
# ============ TWO mke2fs, AND THEY ARE NOT THE SAME PROGRAM ============
#
# e2fsprogs' mke2fs makes ext4. BUSYBOX's mke2fs -- which is what a build
# without BR2_PACKAGE_E2FSPROGS has, and it is enabled in the stock config --
# makes ext2 and rejects -t and -O outright.
#
# So: ask for ext4, and if that is refused, make ext2 and SAY SO. The
# confinement does not depend on which: per-file ownership is an ext2 feature
# and everything the layout rests on works either way. What is lost is the
# journal, which on a card people pull out of a running phone is worth having
# -- hence the log line, and hence e2fsprogs being in both defconfigs.
# ============ WHY THE FORMAT USED TO TAKE MINUTES ============
#
# The owner's report was "I got this beautiful formatting progress bar. Waited
# for it to hit 100%, then it told me that the format failed." Half of that is
# the UI's fault and nd_svc.h carries it. The other half is this function, and
# it is the half that made the format genuinely slow.
#
# The command was:
#
#     mke2fs -t ext4 -F -m0 -L NEODCT -O ^64bit,^metadata_csum DEV
#
# and it has two costs that both scale with the SIZE OF THE CARD:
#
#   THE INODE TABLES. mke2fs writes every one of them out by hand unless it is
#   told not to. At this image's defaults -- inode_ratio 16384, inode_size 256
#   -- that is one byte of inode table for every sixty-four bytes of card:
#   32 MiB on the 2 GB card the tests use, and 2 GiB on a 128 GB card. Small
#   metadata writes are the slowest thing an SD card does, so the test card
#   formatted in seconds and a real one took minutes. That is exactly the shape
#   of a bug that ships.
#
#   THE DISCARD. mke2fs discards the whole device first. On a card whose
#   controller does that synchronously it is minutes on its own, and it buys
#   nothing here: the card is about to be written with a filesystem either way.
#
# `-E lazy_itable_init=1` fixes the first -- the tables are left uninitialised
# and the kernel's ext4lazyinit thread zeroes them in the background after the
# mount, which is what every desktop distribution has done since 2009.
# `lazy_journal_init=1` does the same for the journal blocks, and `nodiscard`
# turns the second off.
#
# ============ AND WHY uninit_bg IS IN THE FEATURE LIST ============
#
# Because lazy_itable_init DOES NOTHING WITHOUT IT, silently. "Do not write the
# inode tables" is only expressible if the group descriptors can say which
# groups are uninitialised, and that needs a group-descriptor checksum --
# either uninit_bg (2006) or metadata_csum (2012). This command line turns
# metadata_csum OFF, so before uninit_bg was added here the -E option was
# accepted, ignored, and every inode table written anyway.
#
# Measured on the host, 32 GiB image, allocated blocks after mke2fs:
#
#     ^64bit,^metadata_csum                      263 MiB
#     ^64bit,^metadata_csum        + lazy -E     519 MiB   (no effect)
#     ^64bit,^metadata_csum,uninit_bg + lazy -E    5 MiB
#
# metadata_csum stays off for the reason it always was -- an older e2fsprogs on
# the owner's PC can still read the card -- and uninit_bg costs nothing there:
# it is six years older than the feature being declined.
MKE2FS_FAST_OPTS="lazy_itable_init=1,lazy_journal_init=1,nodiscard"

# The mke2fs currently running, so the signal handler can reach it. See
# format_interrupted(): the reason mke2fs runs in the background at all is that
# a POSIX shell does not run a trap while a FOREGROUND child is alive, so a
# SIGTERM aimed at this script during a format would sit unhandled until the
# format finished -- by which time the core has sent SIGKILL, this script is
# gone, and mke2fs is an orphan still writing the card.
MKFS_PID=""

run_mkfs() {   # run_mkfs COMMAND...
    "$@" >/dev/null 2>&1 &
    MKFS_PID=$!
    wait "$MKFS_PID"
    _rc=$?
    MKFS_PID=""
    return $_rc
}

mkfs_ext4() {   # mkfs_ext4 DEV
    # -F because the device may already hold a filesystem and destroying it is
    # the point. -m0 because reserving 5% for root on a removable card
    # reserves it for nobody.
    if run_mkfs mke2fs -t ext4 -F -m0 -L "$LABEL" \
            -O ^64bit,^metadata_csum,uninit_bg -E "$MKE2FS_FAST_OPTS" "$1"; then
        return 0
    fi
    # A rung of its own, and not merged with the ext2 one below. An mke2fs that
    # makes ext4 but dislikes one of the extended options above should still
    # produce an ext4 card -- slowly, and saying so -- rather than dropping
    # to ext2 and losing the journal for the sake of a flag.
    if run_mkfs mke2fs -t ext4 -F -m0 -L "$LABEL" -O ^64bit,^metadata_csum "$1"; then
        log "mke2fs would not take $MKE2FS_FAST_OPTS: the inode tables are being"
        log "  written in full, which on a large card is minutes rather than seconds."
        return 0
    fi
    if run_mkfs mke2fs -F -m0 -L "$LABEL" "$1"; then
        log "no ext4 mke2fs in this image: the card is ext2, without a journal."
        log "  Ownership and modes are unaffected. Rebuild with BR2_PACKAGE_E2FSPROGS=y for ext4."
        return 0
    fi
    return 1
}

# ============ LET GO OF THE CARD, OR DO NOT TOUCH IT ============
#
# do_format used to `umount -l` both mounts and then get on with destroying the
# partition table. `umount -l` is MNT_DETACH: it takes the mount out of the
# namespace -- and out of /proc/mounts, so it LOOKS gone -- but releases
# neither the filesystem nor the block device until the last open reference
# goes. Anything still holding a descriptor or a cwd under the card keeps the
# partition open: a player mid-track, the browser's download directory, an app
# whose data/ lives there. BLKRRPART on a disk with an open partition returns
# EBUSY, and by the time partprobe was asked, sectors 446..511 had already been
# overwritten. So the failure was: table destroyed, format aborted, owner told
# "the card may be write protected". That is data loss with a misleading
# message.
#
# A PLAIN umount is the test. It fails with EBUSY exactly when something still
# holds the filesystem, and it fails BEFORE anything has been written -- so a
# card that is in use is refused instead of half-formatted, and refusing costs
# the owner nothing but a message they can act on ("close the music player").
#
# A mountpoint that is not mounted is not a refusal: the card may have been
# pulled, or a previous format may have left it unmounted, and both of those
# are cards that can be formatted.
#
# Deliberately no `umount -l` fallback. Falling back would put us back where we
# started with an extra step, and leaving the card mounted means the record it
# already has stays true.
release_card() {
    for _mp in "$UNTRUSTED_MOUNT" "$MOUNT_POINT"; do
        mountpoint -q "$_mp" 2>/dev/null || continue
        umount "$_mp" 2>/dev/null || return 1
    done
    return 0
}

# ============ ONE EXIT, AND IT ALWAYS PUBLISHES ============
#
# do_format unmounts the card and only then does the work that can fail, and
# five of its failure branches used to `return 1` without touching the state
# file. What the file then still held was whatever the last successful mount
# published -- typically `state=mounted device=/dev/mmcblk1p1` with an
# `untrusted=` path -- for a card that is now unmounted and, once write_mbr has
# run, has no filesystem at all. nd_storage_card() accepts `mounted`, so the UI
# went on naming a device and offering a download directory that was not there.
#
# The state file is a description of reality and every exit from here has to
# leave one. `unformatted` is the honest word for "there is a card in the slot
# and it has nothing readable on it", nd_storage.c already maps it, and Settings
# already offers to format on it -- which is exactly the way out the owner
# needs after a format that failed halfway.
format_fail() {   # format_fail DEVICE MESSAGE...
    _dev="$1"; shift
    log "$*"
    UNTRUSTED_STATE=""
    write_state unformatted "$_dev" "" ""
    return 1
}

# ============ AND ONE MORE EXIT: BEING KILLED HALFWAY ============
#
# The core allows a format a deadline (nd_svc.h) and stops the helper when it
# passes it, and the owner can press Clear at any time, which does the same
# thing. Both arrive here as SIGTERM.
#
# Until now nothing caught it. The script died mid-mke2fs and the state file
# still held whatever the last successful mount had published -- typically
# `state=mounted device=/dev/mmcblk1p1` -- for a card whose partition table had
# just been rewritten and whose filesystem was half made. nd_storage_card()
# accepts `mounted`, so the UI went on naming a device, offering an update
# folder and a download directory, on a card that had none of them. That is
# the same class of lie format_fail() exists to prevent, arriving by the one
# route format_fail() cannot cover, and it is a good candidate for the "the
# phone stopped recognising my card" reports that outlived every other fix.
#
# So: publish the truth and go. `unformatted` is exactly what the card is --
# there is something in the slot and nothing readable on it -- and it is the
# state Settings offers to format on, which is the way out the owner needs.
#
# The marker is removed here as well as in dispatch(). It is what makes the
# udev add/remove handlers stand down during a format, and a marker left behind
# by a killed format would keep them standing down until the next reboot, on a
# phone whose card work is entirely done by those handlers.
#
# The mke2fs is killed first and explicitly. It is a separate process (see
# run_mkfs) and nothing else would ever reap it: the core signals this script's
# pid, not its process group, so an unkilled mke2fs would keep writing the card
# with its parent gone and the phone telling the owner it had stopped.
format_interrupted() {   # format_interrupted DEVICE
    trap - TERM INT HUP
    if [ -n "$MKFS_PID" ]; then
        kill -TERM "$MKFS_PID" 2>/dev/null
        # Not a wait: this handler is itself running against the core's own
        # two-second grace before SIGKILL, and a wait here would spend it.
        sleep 0.5
        kill -KILL "$MKFS_PID" 2>/dev/null
    fi
    rm -f "$FORMAT_MARKER" 2>/dev/null
    log "the format of ${1:-the card} was stopped before it finished"
    UNTRUSTED_STATE=""
    write_state unformatted "${1:-}" "" ""
    sync
    exit 143
}

do_format() {   # do_format DEV -- destroys everything on it
    device="$1"
    # A partition table is written to a DISK, and what the UI hands over is
    # whatever the card was mounted from -- which after the first format is a
    # partition. parent_disk() is the same function is_system_device() uses to
    # decide what is off limits, so the two can never disagree about what a
    # given device belongs to.
    disk="$(parent_disk "$device")"

    # Safety check first, on BOTH spellings, and before anything looks at
    # whether it is a block device at all: never let "format this card" point
    # mkfs at something the phone is running from.
    warn_if_guard_degraded
    if is_reserved_for_format "$device" || is_reserved_for_format "$disk"; then
        log "refusing to format $device: the phone is running from it"
        return 1
    fi
    [ -b "$disk" ] || { log "$disk is not a block device"; return 1; }

    if ! command -v mke2fs >/dev/null 2>&1; then
        # Loud, and a state the UI can render. An image without e2fsprogs
        # cannot make a card, and silently making a FAT one instead would
        # produce a card that mounts and then cannot hold an app -- the
        # failure being invisible is what makes it worth refusing.
        log "no mke2fs in this image: cannot format a card. Rebuild with BR2_PACKAGE_E2FSPROGS=y."
        write_state unformatted "$device" "" ""
        return 1
    fi

    # ============ EVERYTHING THAT CAN FAIL, BEFORE ANYTHING IS DESTROYED ====
    #
    # The order below is the fix for a half-format that lost the partition
    # table and then reported a write-protected card. release_card() carries
    # the reasoning; what matters here is that every step which can refuse now
    # comes before the first step that destroys anything.
    if ! release_card; then
        # Nothing has been touched, so the record the card already has is
        # still true and is deliberately left alone.
        log "$MOUNT_POINT is still in use; the card has NOT been changed"
        return 1
    fi
    UNTRUSTED_STATE=""

    if ! total="$(device_sectors "$disk")"; then
        format_fail "$device" "cannot read the size of $disk"
        return 1
    fi
    p1_start="$ALIGN_SECTORS"
    p1_sectors="$(align_down $(( total - p1_start )))"
    if [ "$p1_sectors" -le 0 ]; then
        format_fail "$device" "$disk is too small to hold a partition"
        return 1
    fi

    log "partitioning $disk: one ext4 partition of $(( p1_sectors / 2048 )) MiB"
    if ! write_mbr "$disk" "$p1_start" "$p1_sectors"; then
        format_fail "$device" "could not write a partition table to $disk"
        return 1
    fi
    if ! reread_partitions "$disk"; then
        format_fail "$device" "the kernel did not pick up the new partition table on $disk"
        return 1
    fi
    # No `udevadm settle` here, and the reason is worth writing down because it
    # is the obvious thing to reach for. BLKRRPART makes the kernel delete and
    # re-add every partition on the disk, so udev now has a remove and an add
    # queued for the card -- but their handlers are this same script, and they
    # are blocked on the lock THIS invocation is holding. Waiting for the queue
    # to drain from inside the lock waits for something that cannot happen
    # until we let go, so it would spend its whole timeout on every format and
    # then carry on anyway. What makes those handlers harmless is do_remove()
    # asking whether the device is actually gone -- see there.

    p1="$(partition_path "$disk" 1)"
    if ! mkfs_ext4 "$p1"; then
        format_fail "$device" "mke2fs failed on $p1"
        return 1
    fi

    # try_mount does the rest: it creates the folders, writes the marker and
    # applies the layout, because those have to happen on every mount and not
    # only on this one.
    #
    # FRESHLY_FORMATTED because card_is_ours() has nothing to go on yet: the
    # filesystem is seconds old and empty, so neither the marker nor the
    # folder set exists. This is the one moment the phone knows the card is
    # its own without having to look.
    FRESHLY_FORMATTED=1
    if ! try_mount "$p1"; then
        FRESHLY_FORMATTED=""
        # try_mount published `unmountable` for the new partition, which is a
        # truthful and more specific answer than format_fail's, so it stands.
        log "the new filesystem on $p1 would not mount"
        return 1
    fi
    FRESHLY_FORMATTED=""
    sync
    log "formatted $disk as a NeoDCT card"
    return 0
}

# ============ ONE OF THESE AT A TIME ============
#
# Five callers reach this script and three of them can arrive at once:
# S12sdcard at boot, the two udev handlers on every partition add and remove,
# and the core through the broker for `format`, `layout` and `setup`. Until
# 0.5.0b that was harmless -- every invocation mounted or unmounted and
# returned -- but `format` is minutes long, destructive, and GENERATES the
# uevents that call the other two: partprobe's BLKRRPART makes the kernel
# delete and re-add every partition on the disk, and udev forks its handlers
# for those asynchronously, against a format that is still running.
#
# Three concrete things went wrong, all of them observed only on hardware
# because on QEMU the whole format finishes before udev has forked a worker:
# the `add` handler mounted and laid out a filesystem mke2fs was still writing
# (mkfs_ext4 passes -F, so mke2fs does not refuse); do_format's own closing
# mount stacked a second mount on the same point, which one `umount -l` can
# never fully detach -- a card that cannot be re-inserted without a reboot; and
# the `remove` handler unmounted the freshly formatted card and published
# `absent` on top of the `mounted` the format had just written.
#
# So: one lock for the whole script, and a marker the handlers check. The lock
# alone would be enough for the first two, but a udev handler that merely waits
# would then run its now-stale decision the moment the format finished -- hence
# both. flock is busybox's and is in this image.
LOCK_FILE="$STATE_DIR/sdcard.lock"
FORMAT_MARKER="$STATE_DIR/.formatting"

formatting_in_flight() {
    [ -e "$FORMAT_MARKER" ]
}

# ============ HOW THE LOCK IS TAKEN, AND WHY NOT THE OBVIOUS WAY =========
#
# The obvious way is `exec flock -w 30 "$LOCK_FILE" "$0" "$@"`, and this file
# shipped that. It does not work: busybox flock takes -s, -x, -n, -u and -c
# and NOTHING ELSE. There is no -w. An unknown option makes it print its usage
# and exit 1 -- so every single invocation of this helper died at that exec,
# before dispatch, with a usage message where the mount should have been. The
# boot scan, both udev handlers and every broker verb: a card in the slot that
# the phone had no code path left to notice, which reads to the owner as a
# card the phone cannot recognise. There is no timeout(1) in this image either
# (CONFIG_TIMEOUT is off), so neither half of the idiom was ever available.
#
# What busybox flock does have is the fd form, `flock -x -n 9`, which locks a
# descriptor the shell already holds and returns. The lock then belongs to this
# process for as long as fd 9 is open, which is the life of the script -- the
# same property the re-exec had, without the re-exec, and the same idiom atcmd
# and nd_modem_at.c use on the modem lock.
#
# A bounded wait rather than a blocking one, which is what -w was reaching for:
# a udev handler that never returns holds a udev worker forever and eudev has a
# finite pool of them. Timing out and doing nothing is the right answer for
# `add`/`remove` -- the format that is holding the lock publishes the truth
# when it finishes -- and `format` itself is the one that will be holding it.
LOCK_WAIT_S="${NEODCT_SDCARD_LOCK_WAIT_S:-30}"

# 0 = held. Polls five times a second, so a handler that has to wait for a
# format spends its budget in forks of flock and nothing else.
take_lock() {
    exec 9>> "$LOCK_FILE" || return 1
    _waited=0
    until flock -x -n 9; do
        _waited=$((_waited + 1))
        [ "$_waited" -ge $((LOCK_WAIT_S * 5)) ] && return 1
        sleep 0.2
    done
    return 0
}

dispatch() {
    case "${1:-scan}" in
        scan)   do_scan ;;
        add)    do_scan ;;
        remove) shift; do_remove "${1:-}" ;;
        format) shift
                _fmt_dev="${1:-}"
                : > "$FORMAT_MARKER" 2>/dev/null
                # Armed around the destructive verb and nothing else. `scan`,
                # `add` and `remove` are short and idempotent; being killed
                # inside one of them leaves a card the next uevent describes
                # correctly, so there is nothing for a handler to say.
                trap 'format_interrupted "$_fmt_dev"' TERM INT HUP
                do_format "$_fmt_dev"
                _rc=$?
                trap - TERM INT HUP
                rm -f "$FORMAT_MARKER" 2>/dev/null
                return $_rc ;;
        layout) do_layout ;;
        setup)  do_setup ;;
        *)      echo "usage: neodct-sdcard {scan|add|remove [DEV]|format DEV|layout|setup}" >&2
                exit 2 ;;
    esac
}

# Sourcing this file (the host test suite does) only defines the functions.
# POSIX sh has no reliable "am I being sourced" test, hence the explicit
# opt-out rather than something clever.
if [ -z "${NEODCT_SDCARD_SOURCE_ONLY:-}" ]; then
    if command -v flock > /dev/null 2>&1; then
        mkdir -p "$STATE_DIR" 2>/dev/null
        if ! take_lock; then
            # Deliberately not a state file write: whoever holds the lock is
            # mid-operation on this same card and will publish the truth about
            # it. Anything written here would be a guess about somebody else's
            # work, and the first thing they did was take the lock.
            log "another neodct-sdcard holds $LOCK_FILE after ${LOCK_WAIT_S}s; doing nothing"
            exit 1
        fi
    fi
    dispatch "$@"
fi
