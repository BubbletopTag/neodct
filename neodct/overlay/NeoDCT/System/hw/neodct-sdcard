#!/bin/sh
# Mount a removable card at /NeoDCT/User/sdcard and publish what was found.
#
# Called three ways:
#   neodct-sdcard scan            at boot, for a card already in the slot
#   neodct-sdcard add DEVNAME     from the udev rule when one is inserted
#   neodct-sdcard remove DEVNAME  from the udev rule when one is pulled
#   neodct-sdcard format DEV      make a fresh NeoDCT card (destructive)
#
# The state file is what System/core/Storage reads, so the UI never has to
# poke at block devices itself:
#   state=mounted|unmountable|share|absent  device=  fstype=  label=
#   untrusted=<path>              empty unless a NeoDCT card's second
#                                 partition is mounted; see below
#
# A card is anything that is not the system or user-data partition -- those
# two come from the kernel cmdline, so this works the same on QEMU virtio
# and on a real SD slot.
#
# ============ TWO PARTITIONS, AND WHY ============
#
# SECURITY-PLAN.md section 1. A NeoDCT card carries two FAT32 partitions, and
# the split is the whole of the storage half of the confinement design.
#
# The constraint it exists to solve: a FAT filesystem HAS no ownership. chown
# and chmod do nothing on one. Permissions come from mount options -- uid=,
# gid=, fmask=, dmask= -- and those apply to the WHOLE FILESYSTEM AT ONCE. So
# there is no way to grant ndusr_ut a subdirectory of a card and deny it the
# rest: one mount, one uid, one gid. A card mounted for the browser is a card
# the browser owns entirely, including any authorized_keys sitting on it.
#
# The way out is that a CARD can carry more than one FILESYSTEM. Mount options
# are per mount and a mount is per block device, so two partitions get two
# genuinely independent sets of ownership -- with no kernel feature, no
# filesystem change, and a card that still reads on any computer.
#
#   p1  NEODCT    uid=ndusr    nosuid,nodev             EXEC ALLOWED
#                 media, wallpapers, tones, updates -- the import side
#   p2  NEODCTUT  uid=ndusr_ut nosuid,nodev,noexec      NO EXEC
#                 downloads and MMS attachments -- the arrival side
#
# The boundary is PROVENANCE, not trust: did the owner choose to put this
# here, or did it arrive? noexec goes on the arrival side only, and that is
# deliberate rather than timid -- noexec refuses mmap(PROT_EXEC) as well as
# execve, so a blanket rule would block emulator cores loaded with dlopen()
# and, if /NeoDCT/User/apps ever lives on a card, nd-apprun's own app.so.
# Installing something therefore becomes an explicit copy from p2 to p1,
# performed by a person through the UI. That is not friction to engineer
# away; it is the one point in the whole design where somebody says "yes,
# run this".
#
# FAT cannot represent a setuid bit or a device node in the first place, which
# is a property worth keeping and the reason this is FAT rather than ext.
# nosuid,nodev are there anyway, because the helper will mount an ext card
# somebody else formatted.
#
# ============ WHAT A FOREIGN CARD GETS ============
#
# Everything it got before. A single-partition FAT card from a PC mounts as
# the media side and there is simply no arrival partition -- untrusted= stays
# empty and the caller has nowhere to put a download, which is the correct
# answer rather than a degraded one. That direction is the one owners
# actually use, and it stays the fast path.
set -u

MOUNT_POINT="${NEODCT_SDCARD_MOUNT:-/NeoDCT/User/sdcard}"
# The arrival partition, mounted INSIDE the media one.
#
# That works, and it is not an accident: p1's dmask below is 0026, so its
# directories are 0751 -- ndusr_ut can traverse "sdcard" to reach "untrusted"
# by name while `ls` of the media side returns EACCES. Exactly the trick
# /NeoDCT/User itself uses, for exactly the same reason.
UNTRUSTED_NAME=untrusted
# A DIRECTORY on the card now, not a second partition.
#
# It was p2, a separate FAT filesystem, because FAT has no ownership of its
# own: uid=/gid=/fmask=/dmask= are mount options and apply to a whole
# filesystem, so "downloads are writable by ndusr_ut and music is not" needed
# two mounts. ext4 stores owner, group and mode per inode, so one filesystem
# expresses both -- and the partition table, the label dance and the
# is_untrusted_partition() guard all go away with it. See CARD_LAYOUT.
UNTRUSTED_MOUNT="${NEODCT_SDCARD_UNTRUSTED:-$MOUNT_POINT/$UNTRUSTED_NAME}"
STATE_DIR="${NEODCT_RUN_DIR:-/run/neodct}"
# Overridable so the host test suite can feed these in.
CMDLINE="${NEODCT_CMDLINE:-/proc/cmdline}"
MOUNTS="${NEODCT_MOUNTS:-/proc/mounts}"
# What the initramfs actually resolved, which beats the cmdline names.
BOOT_STATE="${NEODCT_BOOT_STATE:-/NeoDCT/User/.ndsys/verity_state.prop}"
STATE_FILE="$STATE_DIR/sdcard.prop"
LABEL=NEODCT
FOLDERS="wallpapers tones backup_db music update apps untrusted"

# The filesystems a NeoDCT card may be. ext4 first, and it is the only one
# do_format() writes: the others are here so an ext2/ext3 card somebody else
# made still mounts.
CARD_EXT_FSTYPES="ext4 ext3 ext2"


# The users the two partitions are mounted for. Empty on an image built
# without BR2_ROOTFS_USERS_TABLES, and then the uid=/gid= options are simply
# left off and both mounts belong to root -- which is what every build before
# SECURITY-PLAN.md section 1 did.
CARD_USER="${NEODCT_CARD_USER:-ndusr}"
CARD_USER_UT="${NEODCT_CARD_USER_UT:-ndusr_ut}"

# ============ THE LAYOUT, WHICH IS THE WHOLE OF THE CONFINEMENT ============
#
# "<dir>:<mode>:<owner>:<group>", the empty name being the root of the card.
# Applied after every mount of a NeoDCT card, for the same reason S00userdata
# applies its own on every boot: the card is removable, it can be written on
# any PC, and the modes on it are therefore a claim rather than a fact until
# the phone has restated them.
#
#   .           0751  traverse but do not list, exactly as /NeoDCT/User does
#   apps        0755  installed apps. ndusr_ut may list and traverse; only
#                     ndusr may write, so an app cannot add or remove one
#   untrusted   0770  ndusr:ndusr_ut -- the ONE directory the untrusted set
#                     may write. Downloads land here and the browser and the
#                     media player keep their state here
#   the media   0750  the owner's music, wallpapers, tones, backups and
#                     update packages. ndusr_ut cannot read any of it, which
#                     on the old FAT card was impossible to express
#
# An individual app's directory is 0755 ndusr:ndusr (see apply_app_modes), so
# app.so is READ AND EXECUTE for the app and WRITE for nobody but the owner.
# Its data/ is the app's, and the core makes it -- an app that could create
# its own data directory could create siblings beside its code instead.
CARD_LAYOUT="
:0751:$CARD_USER:$CARD_USER
apps:0755:$CARD_USER:$CARD_USER
untrusted:0770:$CARD_USER:$CARD_USER_UT
music:0750:$CARD_USER:$CARD_USER
wallpapers:0750:$CARD_USER:$CARD_USER
tones:0750:$CARD_USER:$CARD_USER
backup_db:0750:$CARD_USER:$CARD_USER
update:0750:$CARD_USER:$CARD_USER
"

# How much of a fresh card becomes the arrival side. Downloads and MMS
# attachments are small and media is not, so a quarter, floored at 16 MiB so
# a tiny card still gets a usable one and capped at 512 MiB so a 64 GB card
# does not hand over 16 GB nothing will ever fill.
UNTRUSTED_SHARE_PERCENT="${NEODCT_UNTRUSTED_PERCENT:-25}"
UNTRUSTED_MIN_SECTORS=$((16 * 1024 * 1024 / 512))
UNTRUSTED_MAX_SECTORS=$((512 * 1024 * 1024 / 512))
# 1 MiB alignment, which is what every partitioner has used for fifteen years
# and what an SD card's erase blocks want.
ALIGN_SECTORS=$((1024 * 1024 / 512))

log() { echo "[sdcard] $*" >&2; }

# The path the arrival partition is mounted at, or empty. Set by
# mount_untrusted() and cleared by everything that tears a card down, so that
# write_state can publish it without every caller having to pass it.
UNTRUSTED_STATE=""

# What try_mount() last published. A card with two partitions is described by
# ONE record, and the arrival mount is only known after the media one is up --
# so the record has to be written twice, and the second write must not have to
# rediscover what the first one already knew. Re-deriving the fstype from
# /proc/mounts would be the obvious way and the wrong one: it answers a
# different question (what the kernel calls it) and answers nothing at all in
# the host tests, which would quietly blank the field.
MOUNTED_DEVICE=""
MOUNTED_FSTYPE=""
MOUNTED_LABEL=""

# One value out of the record we last wrote, for the path where this process
# did not do the mounting -- the second udev add event for a card whose media
# side another invocation already brought up.
read_state() {   # read_state KEY
    sed -n "s/^$1=//p" "$STATE_FILE" 2>/dev/null | head -n1
}

write_state() {   # write_state STATE DEVICE FSTYPE LABEL
    mkdir -p "$STATE_DIR" 2>/dev/null
    cat > "$STATE_FILE.new" <<EOF
state=$1
device=$2
fstype=$3
label=$4
untrusted=$UNTRUSTED_STATE
EOF
    mv -f "$STATE_FILE.new" "$STATE_FILE"
}

# Devices the phone runs from; never treat these as removable.
#
# The kernel cmdline is only a hint: virtio-mmio devices are not enumerated
# in the order QEMU is handed them, and the first boot that got this wrong
# tried to mount the system image as an SD card. So three sources are used --
# what the initramfs recorded, the cmdline names, and the mount table -- plus
# a content check for the squashfs itself, which is mounted through
# /dev/mapper and so never appears in the mount table under its own name.
system_devices() {
    # What the initramfs resolved, if it left a record. This wins outright:
    # the cmdline names are a hint, and a wrong hint here is worse than no
    # hint at all -- neodct.sys=/dev/vda once named the SD card, so trusting
    # it excluded the card and left no candidate to mount.
    recorded=""
    for key in sys_device user_device; do
        value="$(sed -n "s/^$key=//p" "$BOOT_STATE" 2>/dev/null | head -n1)"
        if [ -n "$value" ]; then
            echo "$value"
            recorded=1
        fi
    done
    [ -n "$recorded" ] && return 0

    # No record (older initramfs, or the user partition is not mounted yet):
    # the names are all we have. The squashfs and mount-table checks in
    # is_reserved_device() still guard against them being wrong.
    for word in $(cat "$CMDLINE" 2>/dev/null); do
        case "$word" in
            neodct.sys=*)  echo "${word#neodct.sys=}" ;;
            neodct.user=*) echo "${word#neodct.user=}" ;;
        esac
    done
}

# "hsqs" is the squashfs magic, and printable, so no od is needed.
is_squashfs() {
    [ -b "$1" ] || [ -f "$1" ] || return 1
    [ "$(dd if="$1" bs=4 count=1 2>/dev/null)" = "hsqs" ]
}

is_mounted() {
    cut -d' ' -f1 "$MOUNTS" 2>/dev/null | grep -qx "$1"
}

# True for anything that must never be touched as a removable card.
is_reserved_device() {
    is_system_device "$1" && return 0
    is_squashfs "$1" && return 0
    is_mounted "$1" && return 0
    return 1
}

# Whole disk a device belongs to: /dev/mmcblk0p1 -> /dev/mmcblk0,
# /dev/sda2 -> /dev/sda, /dev/vdc -> /dev/vdc.
#
# The two naming styles have to be handled separately: mmcblk and nvme names
# end in a digit while still being whole disks, and their partitions are
# suffixed "p<N>" rather than plain digits.
parent_disk() {
    name="$1"
    case "$name" in
        *mmcblk[0-9]p[0-9]*|*nvme[0-9]n[0-9]p[0-9]*|*loop[0-9]p[0-9]*)
            echo "${name%p*}"
            return
            ;;
        *mmcblk[0-9]|*nvme[0-9]n[0-9]|*loop[0-9])
            echo "$name"
            return
            ;;
    esac
    # sda1 / vdc2 style: strip the trailing partition number.
    while :; do
        case "$name" in
            *[0-9]) name="${name%?}" ;;
            *) break ;;
        esac
    done
    echo "$name"
}

# True for anything the phone is running from -- the named partitions and
# any sibling partition on the same physical disk.
is_system_device() {
    mine="$(parent_disk "$1")"
    for reserved in $(system_devices); do
        [ "$1" = "$reserved" ] && return 0
        [ "$mine" = "$(parent_disk "$reserved")" ] && return 0
    done
    return 1
}

# The FAT volume label, read out of the boot sector rather than asked of
# blkid.
#
# Same trick as is_squashfs() above, and for the same reason: busybox's blkid
# has far fewer probers than util-linux's and reported NOTHING for a plain
# mkfs.vfat card, which is the bug that made a perfectly good FAT32 image
# read as "no filesystem we can mount". The boot sector is always there and
# always says the same thing.
#
# FAT32 keeps BS_VolLab at offset 71, eleven space-padded bytes, and
# BS_FilSysType at 82. Both are written by mkfs.vfat, and checking the second
# is what stops a random eleven bytes of some other filesystem reading as a
# label.
fat_label() {   # fat_label DEV
    [ -b "$1" ] || [ -f "$1" ] || return 1
    case "$(dd if="$1" bs=1 skip=82 count=8 2>/dev/null)" in
        FAT32*) ;;
        *) return 1 ;;
    esac
    dd if="$1" bs=1 skip=71 count=11 2>/dev/null | sed -e 's/[[:space:]]*$//'
}

partition_path() {   # partition_path DISK N
    case "${1##*/}" in
        mmcblk[0-9]*|nvme[0-9]*n[0-9]*|loop[0-9]*) echo "$1p$2" ;;
        *) echo "$1$2" ;;
    esac
}

# Size in 512-byte sectors.
#
# /sys/class/block rather than blockdev(1), which busybox is not built with
# here. A plain file is accepted too, so the host tests can drive do_format
# against an image the way they drive everything else.
device_sectors() {   # device_sectors DEV
    name="${1##*/}"
    if [ -r "${NEODCT_SYSFS_BLOCK:-/sys/class/block}/$name/size" ]; then
        cat "${NEODCT_SYSFS_BLOCK:-/sys/class/block}/$name/size"
        return 0
    fi
    if [ -f "$1" ]; then
        echo $(( $(wc -c < "$1") / 512 ))
        return 0
    fi
    return 1
}

# uid or gid of a name, or empty when the image has no such user. Empty is
# the honest answer and the callers leave the mount option off entirely
# rather than guessing a number -- the kernel's vfat driver takes numbers
# only, so a name would be silently ignored and the mount would belong to
# root while looking as though it did not.
name_uid() { id -u "$1" 2>/dev/null; }
name_gid() { id -g "$1" 2>/dev/null; }

fstype_of() {
    blkid "$1" 2>/dev/null | sed -n 's/.*[[:space:]]TYPE="\([^"]*\)".*/\1/p' \
        | head -n1
}

label_of() {
    blkid "$1" 2>/dev/null | sed -n 's/.*[[:space:]]LABEL="\([^"]*\)".*/\1/p' \
        | head -n1
}

# Candidate card devices: partitions first (a real card is usually
# partitioned), then whole disks formatted as a superfloppy.
candidates() {
    for path in /dev/mmcblk*p[0-9] /dev/mmcblk[0-9] /dev/sd[a-z][0-9] \
                /dev/sd[a-z] /dev/vd[a-z][0-9] /dev/vd[a-z]; do
        [ -b "$path" ] || continue
        is_reserved_device "$path" && continue
        echo "$path"
    done
}

# What the kernel says is mounted at a path, from the mount table.
mounted_fstype() {
    awk -v mnt="$1" '$2 == mnt {print $3; exit}' "$MOUNTS" 2>/dev/null
}

# Filesystems to try, in the order a card is likely to be. vfat first: that
# is what a NeoDCT card is.
CARD_FSTYPES="vfat exfat ext4 ext3 ext2"

# On every card mount, whatever is on it.
#
# A card is the one filesystem on this phone whose contents were chosen by
# whoever last held it, and it is mounted automatically on insertion by
# 60-neodct-sdcard.rules -- so "plug this in" is a code path an attacker with
# thirty seconds of physical access controls end to end. FAT cannot represent
# a setuid bit or a device node, so on a NeoDCT card these are defence in
# depth; on the ext card the helper will happily mount (CARD_FSTYPES) they are
# the only thing between a crafted card and a root shell.
#
# noexec is NOT here: it belongs on the partition things ARRIVE on, not on the
# one the owner deliberately copied media to. See SECURITY-PLAN.md section 1,
# "split by provenance, not by trust" -- a blanket noexec would also block
# emulator cores and, if /NeoDCT/User/apps ever lives on a card, nd-apprun's
# own dlopen() of app.so.
CARD_SAFETY_OPTS="nosuid,nodev"

# Who a FAT mount belongs to. Nothing without an owner: a FAT filesystem has
# no ownership of its own, so uid=/gid= are the ONLY way to say who may touch
# what on one, and leaving them off is what makes a card belong to whoever
# mounted it -- root, today.
#
# The masks are subtractive, and the two shapes are deliberate:
#
#   media side    dmask=0026 -> directories 0751, fmask=0137 -> files 0640.
#                 0751 is the same "traverse but do not list" trick
#                 /NeoDCT/User uses: ndusr_ut can walk through to reach the
#                 arrival mount below, and `ls` of the owner's music is
#                 EACCES. Files give it nothing at all.
#
#   arrival side  uid=ndusr_ut so the browser can WRITE, gid=ndusr so the
#                 core can READ. dmask=0027 -> 0750, fmask=0137 -> 0640.
#
# That second gid is a deliberate departure from the plan's table, which has
# gid=ndusr_ut. It has to be: the plan's own workflow is that installing
# something downloaded is "an explicit copy from p2 to p1 that the owner
# performs through the UI", and the UI is ndusr. A group it cannot read is a
# download nobody can ever do anything with.
card_owner_opts() {   # card_owner_opts OWNER GROUP
    _uid="$(name_uid "$1")"
    _gid="$(name_gid "$2")"
    # No such user in this image: say nothing rather than guess a number.
    [ -n "$_uid" ] && [ -n "$_gid" ] || return 0
    echo "uid=$_uid,gid=$_gid"
}

CARD_MEDIA_MASKS="dmask=0026,fmask=0137"
CARD_ARRIVAL_MASKS="dmask=0027,fmask=0137"

try_mount() {   # try_mount DEV
    mkdir -p "$MOUNT_POINT" 2>/dev/null

    # Ask the kernel, not blkid. busybox's blkid has far fewer filesystem
    # probers than util-linux's and reported *nothing* for a plain mkfs.vfat
    # card, so a perfectly good card was announced as having "no filesystem we
    # can read". Whether it mounts is the only question that matters.
    for fstype in $CARD_FSTYPES; do
        case "$fstype" in
            # utf8 keeps accented filenames intact; flush writes through, so
            # pulling the card loses less. Both are FAT-only -- passing them
            # to ext4 makes the mount fail.
            vfat|msdos|exfat) options="rw,noatime,utf8,flush" ;;
            *)                options="rw,noatime" ;;
        esac
        options="$options,$CARD_SAFETY_OPTS"

        # ============ NO uid=/gid=/fmask=/dmask= ON AN EXT CARD ============
        #
        # An ext filesystem carries real ownership, so forcing uid= on one
        # would make every file on it belong to ndusr no matter who wrote it
        # -- and the kernel rejects the option there anyway. The modes come
        # from apply_layout() below instead, which is a stronger thing: it can
        # say something different about apps/ than about music/, which is the
        # whole reason the card is ext4 now.
        #
        # A FAT card still gets the old treatment. It is either somebody
        # else's card or a NeoDCT card from before 0.5.0b, and in both cases
        # it is read-mostly media with no apps on it.
        case "$fstype" in
            vfat|msdos|exfat)
                owner="$(card_owner_opts "$CARD_USER" "$CARD_USER")"
                [ -n "$owner" ] && options="$options,$owner,$CARD_MEDIA_MASKS"
                ;;
        esac
        if mount -t "$fstype" -o "$options" "$1" "$MOUNT_POINT" 2>/dev/null; then
            MOUNTED_DEVICE="$1"; MOUNTED_FSTYPE="$fstype"
            MOUNTED_LABEL="$(label_of "$1")"
            after_mount "$1" "$fstype"
            return 0
        fi
    done

    # Last resort: let the kernel pick from its own probe list.
    if mount -o "rw,noatime,$CARD_SAFETY_OPTS" "$1" "$MOUNT_POINT" 2>/dev/null; then
        fstype="$(mounted_fstype "$MOUNT_POINT")"
        MOUNTED_DEVICE="$1"; MOUNTED_FSTYPE="${fstype:-unknown}"
        MOUNTED_LABEL="$(label_of "$1")"
        after_mount "$1" "${fstype:-unknown}"
        return 0
    fi

    write_state unformatted "$1" "$(fstype_of "$1")" "$(label_of "$1")"
    log "$1 has no filesystem we can mount"
    return 1
}

# True when this filesystem can express per-file ownership, which is the whole
# question the card's layout turns on.
is_ext_fstype() {   # is_ext_fstype FSTYPE
    for _t in $CARD_EXT_FSTYPES; do
        [ "$1" = "$_t" ] && return 0
    done
    return 1
}

# ============ RESTATED ON EVERY MOUNT, NOT SET ONCE AT FORMAT ============
#
# The card is removable and it is now ext4, which means the owner can mount it
# on any Linux PC and chmod 0777 the lot -- deliberately or by copying a tree
# across with the wrong umask. Modes that were correct when the card was
# formatted are therefore a claim about the past, not a fact about the
# present, and the confinement rests on them.
#
# So the phone reasserts the layout every time it mounts one of its own cards,
# exactly as S00userdata reasserts the user partition on every boot. It is
# cheap: eight chmod/chown pairs on directories that already exist.
#
# Only on cards that are OURS -- ext, and labelled NEODCT. Chowning a
# stranger's card would be the phone quietly taking ownership of somebody's
# photographs.
apply_layout() {
    printf '%s\n' "$CARD_LAYOUT" | while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        name="${entry%%:*}"; rest="${entry#*:}"
        mode="${rest%%:*}"; rest="${rest#*:}"
        owner="${rest%%:*}"; group="${rest#*:}"
        path="$MOUNT_POINT/$name"
        [ -z "$name" ] && path="$MOUNT_POINT"
        [ -d "$path" ] || continue
        chown "$owner:$group" "$path" 2>/dev/null
        chmod "$mode" "$path" 2>/dev/null
    done

    # Every installed app, one level down. The directory is the owner's and
    # the app.so inside it is read-only to the app -- that is what stops an
    # app rewriting its own code, and it is the property PentestPersist
    # probes for.
    #
    # ============ AND data/, WHICH IS MADE HERE AND NOT BY THE APP ========
    #
    # Two reasons it is root's job and not the core's:
    #
    #   1. It has to belong to ndusr_ut, and the CORE IS ndusr. Changing a
    #      file's owner to somebody else needs CAP_CHOWN, which is exactly the
    #      privilege the core gave up. This script runs from udev and
    #      S06sdcard, as root, and can.
    #   2. An app that could create its own data directory could create
    #      SIBLINGS instead -- another .so next to the one the launcher
    #      loads. Making it here means the app only ever writes inside a
    #      directory it did not make.
    #
    # ndusr:ndusr_ut 0770, so the app writes and the core can read it back to
    # uninstall. Group-writable means every untrusted app can reach every
    # other's data, because they are all ndusr_ut -- one uid, one principal.
    # That is the honest state today and the shape does not have to change to
    # fix it: a uid per installed app turns this same directory into a real
    # boundary with no rearranging.
    #
    # The contents are NOT touched. It is the app's, and a blanket chmod on
    # every mount would take it back.
    for appdir in "$MOUNT_POINT/apps"/*/; do
        [ -d "$appdir" ] || continue
        chown "$CARD_USER:$CARD_USER" "$appdir" 2>/dev/null
        chmod 0755 "$appdir" 2>/dev/null
        for f in "$appdir"*; do
            [ -f "$f" ] || continue
            chown "$CARD_USER:$CARD_USER" "$f" 2>/dev/null
            chmod 0644 "$f" 2>/dev/null
        done
        mkdir -p "$appdir/data" 2>/dev/null
        chown "$CARD_USER:$CARD_USER_UT" "$appdir/data" 2>/dev/null
        chmod 0770 "$appdir/data" 2>/dev/null
    done
}

# What happens after any successful mount: decide what KIND of card this is,
# fix it up if it is ours, and publish one record describing all of it.
after_mount() {   # after_mount DEV FSTYPE
    UNTRUSTED_STATE=""

    if ! is_ext_fstype "$2"; then
        # ============ A CARD FROM BEFORE 0.5.0b, OR SOMEBODY ELSE'S ========
        #
        # FAT cannot express the layout above, so this card can hold media and
        # nothing else: no apps, and no arrival directory, because a directory
        # ndusr_ut may write cannot be created on a filesystem with no notion
        # of who owns what. `untrusted=` stays empty and the browser has
        # nowhere to download to, which is the correct answer rather than a
        # degraded one.
        #
        # `legacy` rather than `mounted` so the UI can say so and offer to
        # format. That is a destructive offer and it is the owner's to accept:
        # the phone will not reformat a card it found.
        if [ "$(label_of "$1")" = "$LABEL" ]; then
            log "$1 is a NeoDCT card in the old FAT format; it can hold media but not apps"
            write_state legacy "$1" "$2" "$(label_of "$1")"
        else
            log "mounted $1 ($2) at $MOUNT_POINT"
            write_state mounted "$1" "$2" "$(label_of "$1")"
        fi
        return 0
    fi

    if [ "$(label_of "$1")" = "$LABEL" ]; then
        for folder in $FOLDERS; do
            mkdir -p "$MOUNT_POINT/$folder" 2>/dev/null
        done
        apply_layout
        UNTRUSTED_STATE="$UNTRUSTED_MOUNT"
    fi
    log "mounted $1 ($2) at $MOUNT_POINT"
    write_state mounted "$1" "$2" "$(label_of "$1")"
    return 0
}

mount_share() {
    # QEMU convenience: a host folder exported over virtiofs. Tagged on the
    # kernel cmdline by neodct/tools/run_qemu.sh.
    for word in $(cat "$CMDLINE" 2>/dev/null); do
        case "$word" in
            neodct.sdshare=*)
                tag="${word#neodct.sdshare=}"
                mkdir -p "$MOUNT_POINT" 2>/dev/null
                if mount -t virtiofs -o "$CARD_SAFETY_OPTS" "$tag" \
                        "$MOUNT_POINT" 2>/dev/null; then
                    write_state share "$tag" virtiofs ""
                    log "mounted virtiofs share $tag at $MOUNT_POINT"
                    return 0
                fi
                log "virtiofs share $tag failed to mount"
                ;;
        esac
    done
    return 1
}

# What the mount table says is mounted AT a path, by device.
mounted_device() {   # mounted_device MOUNTPOINT
    awk -v mnt="$1" '$2 == mnt {print $1; exit}' "$MOUNTS" 2>/dev/null
}

do_scan() {
    if mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
        # Already mounted. It used to matter that udev fires one add event per
        # PARTITION -- the second event was how the arrival partition got
        # mounted. A NeoDCT card has one partition now, so there is nothing
        # for a second event to do.
        return 0
    fi
    mount_share && return 0
    for device in $(candidates); do
        try_mount "$device" && return 0
    done
    write_state absent "" "" ""
    return 0
}

do_remove() {
    # Inner mount first. `umount -l` on the parent would detach the subtree
    # and leave the arrival filesystem attached to nothing, which is a card
    # that cannot be re-inserted without a reboot.
    umount -l "$UNTRUSTED_MOUNT" 2>/dev/null
    umount -l "$MOUNT_POINT" 2>/dev/null
    UNTRUSTED_STATE=""
    write_state absent "" "" ""
    log "card removed"
}

# --- laying down a partition table, by hand -------------------------------
#
# There is no sfdisk, no cfdisk and no parted in this image, and busybox's
# fdisk has no batch mode -- it is an interactive program and nothing else.
# The two ways forward are piping a keystroke sequence into it and hoping its
# prompts never change, or writing the 446th to 512th bytes of the device
# ourselves. The second is 66 bytes of a format that has not changed since
# 1983, it is deterministic, and it is testable on the host against an image
# file. So: this.
#
# An MBR partition entry is sixteen bytes:
#
#   +0   status              0x00, not bootable -- nothing boots off a card
#   +1   first sector CHS    0xFE 0xFF 0xFF, the "look at the LBA instead"
#                            placeholder every partitioner writes now
#   +4   type                0x0C, FAT32 with LBA addressing
#   +5   last sector CHS     same placeholder
#   +8   first LBA           4 bytes, little-endian
#   +12  sector count        4 bytes, little-endian
#
# and the table is four of those at offset 446, then 0x55 0xAA at 510.

# A 32-bit little-endian integer, as four bytes.
#
# Two printfs, and the second one is not redundant. `printf '\%03o' 12` does
# not emit byte 014 -- \% is not an escape sequence, so printf prints a
# backslash and then formats the number, giving the five CHARACTERS "\014".
# The first printf below builds exactly that text; the second interprets it.
# Getting this wrong produces a partition table made of ASCII, which is
# precisely as broken as it sounds and precisely as quiet.
#
# The NUL bytes survive because it is the TEXT "\000" that passes through the
# command substitution -- a real NUL would not.
le32() {   # le32 VALUE
    _v="$1"
    _esc="$(printf '\\%03o\\%03o\\%03o\\%03o' \
        $((_v & 255)) $(((_v >> 8) & 255)) $(((_v >> 16) & 255)) \
        $(((_v >> 24) & 255)))"
    printf "$_esc"
}

# One partition entry, sixteen bytes.
#
# Type 0x83, Linux. It was 0x0c (FAT32 LBA) when the card was FAT, and the
# byte is not decoration: a PC that reads the table decides what to try
# mounting from it, and an ext4 filesystem inside a partition claiming to be
# FAT32 is a card that a desktop offers to repair.
mbr_entry() {   # mbr_entry FIRST-LBA SECTORS
    printf '\000\376\377\377\203\376\377\377'
    le32 "$1"
    le32 "$2"
}

# Round down to the alignment. Every partition starts and ends on a 1 MiB
# boundary, which is what SD card erase blocks want and what stops a card
# performing like a floppy.
align_down() { echo $(( ($1 / ALIGN_SECTORS) * ALIGN_SECTORS )); }

# write_mbr DISK P1-START P1-SECTORS
#
# One entry now. The second was the arrival partition, which ext4 turned into
# a directory -- see CARD_LAYOUT.
#
# Assembled in a temp file and copied, rather than piped straight at the
# card. Two reasons, and the first one is not a preference:
#
#   dd reads a pipe with one read() per block, and a read() from a pipe
#   returns whatever happens to be in it. `dd bs=512 count=1` on the far end
#   of this therefore takes the first 446 bytes and stops -- which is a
#   partition table with no partitions in it, written to a card, silently.
#   That is exactly what the first version of this did.
#
#   And the length can be checked before anything touches the device. 512
#   bytes or nothing is a cheap thing to insist on in the one function here
#   that can make a card unreadable.
write_mbr() {
    _tmp="${TMPDIR:-/tmp}/.neodct-mbr.$$"

    {
        # 446 bytes of nothing where boot code would be, because nothing
        # boots off a card.
        dd if=/dev/zero bs=446 count=1 2>/dev/null
        mbr_entry "$2" "$3"
        # Entries two, three and four, empty.
        dd if=/dev/zero bs=48 count=1 2>/dev/null
        printf '\125\252'
    } > "$_tmp" 2>/dev/null

    if [ "$(wc -c < "$_tmp" 2>/dev/null)" != "512" ]; then
        rm -f "$_tmp"
        return 1
    fi
    dd if="$_tmp" of="$1" bs=512 count=1 conv=notrunc 2>/dev/null
    _rc=$?
    rm -f "$_tmp"
    return $_rc
}

# Ask the kernel to look at the table again. Without this the partition nodes
# for a freshly written table do not exist and the mkfs below has nothing to
# write to.
reread_partitions() {   # reread_partitions DISK
    sync
    partprobe "$1" > /dev/null 2>&1 || return 1
    # udev has to catch up before the nodes appear. Not a race worth being
    # clever about: this runs once, from a menu, with a person waiting.
    _tries=0
    while [ "$_tries" -lt 50 ]; do
        # Partition ONE, and only one. This waited for p2 as well, which after
        # the move to a single ext4 partition is a device node that never
        # appears -- so every format would have run the table out and then
        # reported that the kernel had not picked it up.
        [ -b "$(partition_path "$1" 1)" ] && \
            return 0
        sleep 0.1
        _tries=$((_tries + 1))
    done
    return 1
}

# The formatter, and the only filesystem the phone ever writes to a card.
#
# It was two FAT partitions. ext4 is what makes the layout above expressible
# at all -- see CARD_LAYOUT -- so a card the phone formats is one ext4
# partition and the ownership does the work the partition table used to.
# ============ TWO mke2fs, AND THEY ARE NOT THE SAME PROGRAM ============
#
# e2fsprogs' mke2fs makes ext4. BUSYBOX's mke2fs -- which is what a build
# without BR2_PACKAGE_E2FSPROGS has, and it is enabled in the stock config --
# makes ext2 and rejects -t and -O outright.
#
# So: ask for ext4, and if that is refused, make ext2 and SAY SO. The
# confinement does not depend on which: per-file ownership is an ext2 feature
# and everything the layout rests on works either way. What is lost is the
# journal, which on a card people pull out of a running phone is worth having
# -- hence the log line, and hence e2fsprogs being in both defconfigs.
mkfs_ext4() {   # mkfs_ext4 DEV
    # -F because the device may already hold a filesystem and destroying it is
    # the point. -m0 because reserving 5% for root on a removable card
    # reserves it for nobody. -O ^64bit,^metadata_csum keeps the card readable
    # by an older e2fsprogs on the owner's PC, which is most of the reason to
    # pick a filesystem Linux reads everywhere.
    if mke2fs -t ext4 -F -m0 -L "$LABEL" -O ^64bit,^metadata_csum "$1" >/dev/null 2>&1; then
        return 0
    fi
    if mke2fs -F -m0 -L "$LABEL" "$1" >/dev/null 2>&1; then
        log "no ext4 mke2fs in this image: the card is ext2, without a journal."
        log "  Ownership and modes are unaffected. Rebuild with BR2_PACKAGE_E2FSPROGS=y for ext4."
        return 0
    fi
    return 1
}

do_format() {   # do_format DEV -- destroys everything on it
    device="$1"
    # A partition table is written to a DISK, and what the UI hands over is
    # whatever the card was mounted from -- which after the first format is a
    # partition. parent_disk() is the same function is_system_device() uses to
    # decide what is off limits, so the two can never disagree about what a
    # given device belongs to.
    disk="$(parent_disk "$device")"

    # Safety check first, on BOTH spellings, and before anything looks at
    # whether it is a block device at all: never let "format this card" point
    # mkfs at something the phone is running from.
    if is_reserved_device "$device" || is_reserved_device "$disk"; then
        log "refusing to format $device: the phone is running from it"
        return 1
    fi
    [ -b "$disk" ] || { log "$disk is not a block device"; return 1; }

    if ! command -v mke2fs >/dev/null 2>&1; then
        # Loud, and a state the UI can render. An image without e2fsprogs
        # cannot make a card, and silently making a FAT one instead would
        # produce a card that mounts and then cannot hold an app -- the
        # failure being invisible is what makes it worth refusing.
        log "no mke2fs in this image: cannot format a card. Rebuild with BR2_PACKAGE_E2FSPROGS=y."
        write_state unformatted "$device" "" ""
        return 1
    fi

    umount -l "$UNTRUSTED_MOUNT" 2>/dev/null
    umount -l "$MOUNT_POINT" 2>/dev/null
    UNTRUSTED_STATE=""

    total="$(device_sectors "$disk")" || {
        log "cannot read the size of $disk"
        return 1
    }
    p1_start="$ALIGN_SECTORS"
    p1_sectors="$(align_down $(( total - p1_start )))"
    if [ "$p1_sectors" -le 0 ]; then
        log "$disk is too small to hold a partition"
        return 1
    fi

    log "partitioning $disk: one ext4 partition of $(( p1_sectors / 2048 )) MiB"
    if ! write_mbr "$disk" "$p1_start" "$p1_sectors"; then
        log "could not write a partition table to $disk"
        return 1
    fi
    if ! reread_partitions "$disk"; then
        log "the kernel did not pick up the new partition table on $disk"
        return 1
    fi

    p1="$(partition_path "$disk" 1)"
    if ! mkfs_ext4 "$p1"; then
        log "mke2fs failed on $p1"
        return 1
    fi

    # try_mount does the rest: it creates the folders and applies the layout,
    # because those have to happen on every mount and not only on this one.
    try_mount "$p1" || return 1
    sync
    log "formatted $disk as a NeoDCT card"
    return 0
}

# Sourcing this file (the host test suite does) only defines the functions.
# POSIX sh has no reliable "am I being sourced" test, hence the explicit
# opt-out rather than something clever.
if [ -z "${NEODCT_SDCARD_SOURCE_ONLY:-}" ]; then
    case "${1:-scan}" in
        scan)   do_scan ;;
        add)    do_scan ;;
        remove) do_remove ;;
        format) shift; do_format "${1:-}" ;;
        *)      echo "usage: neodct-sdcard {scan|add|remove|format DEV}" >&2
                exit 2 ;;
    esac
fi
