    "glass_top":   "#F2F9FF",
    "glass_bot":   "#C6DFF2",

    "chrome_hi":   "#FFFFFF",
    "chrome_top":  "#DAE7F2",
    "chrome_bot":  "#8EA8BE",

    "sky_top":     "#9EDCF7",
