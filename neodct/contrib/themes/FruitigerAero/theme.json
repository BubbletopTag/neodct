    "green_top":   "#9EE84A",
    "green_bot":   "#3D9A14",

    "amber_top":   "#FFD95C",
    "amber_bot":   "#D8880A",
    "red_top":     "#FF8A7A",
    "red_bot":     "#B41C14",

    "ink_dark":    "#0C2A47",
