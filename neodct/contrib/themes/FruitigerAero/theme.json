{
  "id": "aero",
  "name": "Frutiger Aero",
  "author": "NeoDCT",
  "version": "1.1",
  "description": "Glass and gradients in deep sky blue. Glossy plates lit from above with a hard-edged sheen across their top half, white type carrying a soft shadow, and a bright bevel inside every edge. Brings its own icons, status indicators, rounded typeface and sky wallpaper.",

  "style": {
    "gloss":         true,
    "bevel":         true,
    "gradients":     true,
    "round":         true,
    "type_shadow":   true,
    "plate_shadow":  true,
    "bevel_divider": true,
    "icon_glow":     true,
    "reflection":    true,
    "scrim":         true,
    "pixel_font":    false,
    "game_colour":  true,
    "wallpaper_dim": 48,
    "app_wallpaper_dim": 70
  },

  "palette": {
    "blue_hi":     "#5CC3F5",
    "blue_top":    "#2A9BE8",
    "blue_mid":    "#0F6CC8",
    "blue_bot":    "#0A4A9B",
    "blue_deep":   "#062E63",

    "bar_top":     "#2A9BE8",
    "bar_bot":     "#0A4A9B",
    "bar_ink":     "#FFFFFF",
    "sel_ink":     "#FFFFFF",
    "warn_ink":    "#FF0000",

    "glass_top":   "#F2F9FF",
    "glass_bot":   "#C6DFF2",

    "chrome_hi":   "#FFFFFF",
    "chrome_top":  "#DAE7F2",
    "chrome_bot":  "#8EA8BE",

    "sky_top":     "#9EDCF7",
    "sky_bot":     "#144E8F",

    "green_top":   "#9EE84A",
    "green_bot":   "#3D9A14",

    "amber_top":   "#FFD95C",
    "amber_bot":   "#D8880A",
    "red_top":     "#FF8A7A",
    "red_bot":     "#B41C14",

    "ink_dark":    "#0C2A47",
    "ink_light":   "#FFFFFF",
    "ink_muted":   "#9EDCF7",

    "text_shadow": "#081E33",
    "text_sheen":  "#FFFFFF",
    "scrim_ink":   "#041428"
  },

  "alpha": {
    "scrim_top":    96,
    "scrim_bot":     0,
    "appsel_scrim": 70,
    "shadow":      150,
    "sheen":       110
  }
