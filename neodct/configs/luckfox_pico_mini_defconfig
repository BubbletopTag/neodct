BR2_arm=y
BR2_cortex_a7=y
# The RV1103's Cortex-A7 really does have VFPv4 and NEON with Fused-MAC:
# the displayd binary that ran on the board reports Tag_FP_arch VFPv4 and
# Tag_Advanced_SIMD_arch "NEONv1 with Fused-MAC". Plain -mfpu=neon is the
# VFPv3-era setting and leaves both unused.
BR2_ARM_FPU_NEON_VFPV4=y
# Thumb-2 is roughly 30% denser than ARM for the same code. On a part with
# 32 KB of L1 instruction cache that density buys more than the occasional
# extra instruction costs.
BR2_ARM_INSTRUCTIONS_THUMB2=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_JLEVEL=8
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_GENERIC_HOSTNAME="neodct"
BR2_TARGET_GENERIC_ISSUE="NeoDCT System v0.3.0a REAL HW EVT0!!!!!"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="board/qemu/busybox.fragment"
BR2_SYSTEM_DHCP=""
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# musl instead of the buildroot default (glibc). Approved by the project
# owner for the C rewrite; docs/c-rewrite/MUSL.md has the reasoning and the
# migration order. It is worth roughly 1-2 MB on a 64 MB device.
#
# The one thing that used to block this is gone: NeoDCT/System/hw/neodct_displayd
# was a committed glibc-linked ARM binary whose interpreter
# (/lib/ld-linux-armhf.so.3) does not exist under musl, so the kernel could not
# exec it at all. It is now built from source by the neodct package below.
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TARGET_TZ_INFO=y
BR2_ROOTFS_OVERLAY="../neodct/overlay"
# Two users, so that "the browser" and "the phone" stop being the same
# principal. SECURITY-PLAN.md section 1; the table itself carries the
# reasoning, including why the ids are written out rather than allocated.
BR2_ROOTFS_USERS_TABLES="../neodct/configs/users-table.txt"
BR2_ROOTFS_POST_BUILD_SCRIPT="../neodct/scripts/post-build-prune-tests.sh ../neodct/scripts/post-build-system-metadata.sh ../neodct/scripts/post-build-nonfree-firmware.sh ../neodct/scripts/post-build-bt-on-demand.sh"
BR2_ROOTFS_POST_BUILD_SCRIPT_ARGS="luckfox-armv7"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/qemu/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_DEFCONFIG)"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.47"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_DEJAVU=y
# python3, Pillow, mutagen and miniaudio were here until the last app was
# ported. Nothing on the phone runs Python any more: /bin/run_neodct.sh
# execs nd-core, and nd-apprun dlopen()s <app-dir>/app.so. The sources they
# used to run are kept, out of the overlay, in neodct/python-reference --
# the port cites them by file and line and they must not ship.
#
# sqlite USED TO ARRIVE ONLY THROUGH BR2_PACKAGE_PYTHON3_SQLITE. Dropping
# python without it builds cleanly and gives a phone with no phonebook, no
# messages and no call log; BR2_PACKAGE_NEODCT selects it (and freetype,
# jpeg, libpng, zlib and openssl) in its Config.in for exactly that reason.
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_ALSA_UTILS=y
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_MPV=y
# ffmpeg carries every decoder it has unless told otherwise, which makes
# libavcodec 11.6 MB. On a 56 MB phone that matters for a reason that is
# not obvious: with the browser also resident there is not enough memory
# to keep the decoder's own machine code paged in, so it is evicted and
# faulted back off compressed squashfs -- measured at ~300 major faults a
# second, which looks exactly like a slow codec and is not one.
#
# Video is deliberately just two: H.264 in MP4, which is what the web has,
# and MJPEG in AVI, which is what a video transcoded for this screen should
# be.
#
# Audio is NOT optional and is not only about video. mpv is what plays the
# ringtones, the DTMF tones, the SMS tone, Koki's audio and MusicPlayer's
# fallback -- 35 .mp3 and 51 .wav files ship in the overlay alone, and
# MusicPlayer's UI promises .flac and .ogg on a card as well. Trimming to
# the video formats breaks every one of them silently: the phone boots,
# the tone list scrolls, and nothing makes a sound.
# test_ffmpeg_codec_coverage.py holds this list to what the overlay ships.
BR2_PACKAGE_FFMPEG_ENCODERS=""
BR2_PACKAGE_FFMPEG_MUXERS=""
BR2_PACKAGE_FFMPEG_DECODERS="h264 mjpeg aac mp3 flac vorbis pcm_s16le pcm_u8 pcm_s16be"
BR2_PACKAGE_FFMPEG_DEMUXERS="mov avi mp3 wav flac ogg aac"
BR2_PACKAGE_FFMPEG_PARSERS="h264 mjpeg aac mpegaudio flac vorbis"

BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_NETSURF=y
BR2_PACKAGE_NETSURF_FRAMEBUFFER=y
BR2_PACKAGE_UQMI=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_UBIFS=y
BR2_TARGET_ROOTFS_UBIFS_LEBSIZE=0x1f000
BR2_TARGET_ROOTFS_UBIFS_MAXLEBCNT=800
BR2_TARGET_ROOTFS_UBIFS_XZ=y
BR2_TARGET_ROOTFS_UBIFS_OPTS="-F"
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_TARGET_ROOTFS_UBI=y
BR2_TARGET_ROOTFS_UBI_PEBSIZE=0x20000
BR2_TARGET_ROOTFS_UBI_SUBSIZE=2048
BR2_TARGET_ROOTFS_UBI_OPTS="-O 2048"

# --- SD card support (shared with the QEMU flavour) ---
# Real hardware needs these to mount, name and repair a FAT32 card; the
# squashfs/verity switch for NAND comes with the UBI layout work.
BR2_PACKAGE_LVM2=y
# BR2_PACKAGE_LVM2_STANDARD_INSTALL is not set
# ---- e2fsprogs: the card is ext4 now ------------------------------------
#
# A memory card was two FAT partitions until 0.5.0b. FAT stores no ownership,
# so every permission on one came from uid=/gid=/fmask=/dmask= mount options
# applied to the WHOLE filesystem -- which is why "downloads are writable by
# ndusr_ut and the owner's music is not" needed a second partition, and why an
# installed app's app.so could not be made readable to the process that has to
# dlopen it without making every file on the card readable too.
#
# ext4 records owner, group and mode per inode. One partition then expresses
# the whole layout (see neodct-sdcard's CARD_LAYOUT) and the partition table
# goes away with the problem.
#
# busybox has an mke2fs and it is already enabled, but it makes ext2 and
# rejects -t/-O. The helper falls back to it and logs that the card has no
# journal; this is what makes a phone-formatted card ext4 instead.
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_MKE2FS=y
BR2_PACKAGE_E2FSPROGS_E2FSCK=y

BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# --- Remote Shell (engineering mode) ---
# ssh/sftp to the phone over the internet, so development does not need two
# serial wires soldered to the back of it. Off unless deliberately enabled;
# see docs/REMOTE_SHELL.md. openssh rather than dropbear because sftp-server
# comes with it, and the OpenSSL it links is already in the image for the
# browser and python.
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_KEY_UTILS=y

# --- The C rewrite ---
# nd-core, nd-apprun, libneodct, the app .so files and the ST7789 panel
# daemon, built from neodct/src by buildroot/package/neodct. This is what
# /bin/run_neodct.sh execs, and now the only thing it execs: the last app is
# ported, so python3 and Pillow have left the image (see above).
#
# Selects sqlite, freetype, jpeg, libpng, zlib and openssl in its Config.in,
# so that dropping python takes none of them with it.
BR2_PACKAGE_NEODCT=y

# --- Bluetooth (engineering) ---
# Nothing is added here on purpose, and that is the decision worth recording.
#
# A TP-Link UB500 (2357:0604, an RTL8761BU) is driven by the kernel:
# CONFIG_BT + CONFIG_BT_HCIBTUSB + CONFIG_BT_HCIBTUSB_RTL in the SDK's
# luckfox_rv1106_linux_defconfig, plus two firmware files installed by
# neodct/scripts/post-build-nonfree-firmware.sh out of neodct/nonfree/rtl_bt/.
#
# BlueZ was deliberately absent here for as long as Bluetooth meant the
# engineering app, which is ~400 lines of ioctl on an AF_BLUETOOTH socket in
# neodct/src/lib/nd_bt.c and needs no daemon. The note that stood here said
# the argument would stop holding "the day pairing, A2DP or RFCOMM is wanted".
# A2DP is wanted: Settings can connect earbuds and route ALSA to them, and
# every part of that -- Secure Simple Pairing, the link key, AVDTP signalling
# -- is an event-driven HCI session, which is the thing bluetoothd exists to
# run. So it is set now, matching the QEMU config it was proven on.
#
# Measured on QEMU before this was accepted: 2.8 MiB of flash, ~6 MB PSS with
# all three daemons up (dbus 519 KB, bluetoothd 2.1 MB, bluealsa 3.5 MB). This
# board has the same 64 MB, so the same rule applies and is enforced the same
# way -- NOTHING here starts at boot. post-build-bt-on-demand.sh removes
# buildroot's S30dbus and S40bluetoothd; the daemons come up when Settings
# enables Bluetooth, and bluealsa only lives while a device is connected.
# Idle cost is zero. docs/BLUETOOTH.md has the whole reasoning.
#
# Only the audio plugins are built. midi, hcitop and rfcomm are not.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y
# bluetoothctl, driven as a subprocess -- the same shape this OS already uses
# for ssh, sshd, arecord and aplay. It costs readline.
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ_ALSA=y
#
# The firmware is in neodct/nonfree/ rather than from BR2_PACKAGE_LINUX_FIRMWARE
# (+ _RTL_87XX_BT) because that tarball is 583 MB compressed and buildroot
# extracts the whole tree into EACH output directory -- there are two here --
# and it would put 338 KB of firmware for seven other Realtek parts onto a
# 128 MB NAND. Two files and their licence is 44 KB.
