# the connection
# ------------------------------------------------------------------ #

def recv_exact(sock, n):
    out = bytearray()
    while len(out) < n:
        chunk = sock.recv(min(n - len(out), 1 << 16))
        if not chunk:
            raise ConnectionError("phone closed the connection")
        out += chunk
    return bytes(out)


class Link:
    """One connection to nd-watchd, re-made whenever it drops -- a phone that
    reboots while you watch comes back into the same window."""

    def __init__(self, host, port, audio, mute_phone):
        self.host, self.port = host, port
        self.mute_phone = mute_phone
        self.audio = audio
        self.lock = threading.Lock()
        self.rects = []
        self.sock = None
        self.hello = None
        self.status = "connecting to %s:%d" % (host, port)
        self.stop = False
        self.video_bytes = 0
        self.frames = 0
        self.audio_bytes = 0
        self.key_events = []     # (code, down, monotonic) from the key echo
        self.stats = None        # latest 'S' as a dict, with its arrival time
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        while not self.stop:
            try:
                s = socket.create_connection((self.host, self.port), timeout=3)
                s.settimeout(10)
                s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
                s.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 1 << 20)
                self._session(s)
            except (OSError, ConnectionError, ValueError) as exc:
                self.status = "reconnecting -- %s" % exc
            finally:
                with self.lock:
                    self.sock = None
            if not self.stop:
                time.sleep(1)

    def _session(self, s):
        t, n = HDR.unpack(recv_exact(s, HDR.size))
        body = recv_exact(s, n)
        if t != ord("H") or body[:4] != b"NDW1":
            raise ValueError("not nd-watchd on the other end")
        w, h, pixfmt, keys, fps = struct.unpack_from("<HHBBH", body, 4)
        if pixfmt != 1:
            raise ValueError("pixel format %d not understood" % pixfmt)
        self.hello = {"w": w, "h": h, "keys": bool(keys), "fps": fps}
        with self.lock:
            self.sock = s
        self.status = ""
        self.send_options()
        # Idle is normal -- a phone with nothing changing sends nothing -- so
        # the socket timeout is only for the connect and the hello.
        s.settimeout(None)
        while not self.stop:
            t, n = HDR.unpack(recv_exact(s, HDR.size))
            body = recv_exact(s, n)
            if t == ord("V"):
                x, y, rw, rh = struct.unpack_from("<HHHH", body)
                with self.lock:
                    self.rects.append((x, y, rw, rh, body[8:]))
                self.video_bytes += n
                self.frames += 1
            elif t == ord("k"):
                code, down = struct.unpack_from("<iB", body)
                with self.lock:
                    self.key_events.append((code, bool(down), time.monotonic()))
            elif t == ord("S"):
                cpu, _, total, avail, stotal, sfree = struct.unpack_from("<HHIIII", body)
                self.stats = {"cpu": None if cpu == 0xFFFF else cpu / 10.0,
                              "total": total, "avail": avail,
                              "stotal": stotal, "sfree": sfree,
                              "at": time.monotonic()}
            elif t == ord("A"):
                rate, ch, bits = struct.unpack_from("<IHH", body)
                self.audio_bytes += n
                if self.audio is not None:
                    self.audio.push(rate, ch, bits, body[8:])
            # anything else: skipped, as the protocol says

    def take_key_events(self):
        with self.lock:
            e, self.key_events = self.key_events, []
        return e

    def take_rects(self):
        with self.lock:
            r, self.rects = self.rects, []
        return r

    def send_options(self):
        """Ask the phone to mute its speaker while this window is open. Sent
        on every connect, since the phone restores it when a viewer goes."""
        self._send(HDR.pack(ord("O"), 4) + struct.pack("<B3x", 1 if self.mute_phone else 0))

    def _send(self, data):
        with self.lock:
            s = self.sock
        if s is None:
            return
        try:
            s.sendall(data)
        except OSError:
            pass

    def send_key(self, code, down):
        self._send(HDR.pack(ord("K"), 8) + struct.pack("<iB3x", code, 1 if down else 0))


