def blit_565(canvas, x, y, w, h, data):
    """Paint one RGB565LE rectangle into the canvas. SDL does the colour
    conversion in C; the rows are copied one by one only when SDL has padded
    the surface's pitch past w*2."""
    s = pygame.Surface((w, h), 0, 16, (0xF800, 0x07E0, 0x001F, 0))
    pitch = s.get_pitch()
    buf = s.get_buffer()
    if pitch == w * 2:
        buf.write(data, 0)
    else:
        for row in range(h):
            buf.write(data[row * w * 2:(row + 1) * w * 2], row * pitch)
    del buf
    canvas.blit(s, (x, y))


SCALERS = ("sharp", "nearest", "smooth")


def fit(canvas, size, mode):
    ww, wh = size
    k = min(ww / FB_W, wh / FB_H)
    dw, dh = max(1, int(FB_W * k)), max(1, int(FB_H * k))
    if mode == "smooth":
        img = pygame.transform.smoothscale(canvas, (dw, dh))
    elif mode == "nearest":
        img = pygame.transform.scale(canvas, (dw, dh))
    else:
        n = max(1, int(k))
        img = pygame.transform.scale(canvas, (FB_W * n, FB_H * n))
        if (dw, dh) != img.get_size():
            img = pygame.transform.smoothscale(img, (dw, dh))
    return img, ((ww - dw) // 2, (wh - dh) // 2)


# ------------------------------------------------------------------ #
# --verbose: the keys window
# ------------------------------------------------------------------ #

class KeysWindow:
    """A second window: every key the phone is taking in right now, and its
    CPU and RAM.

    The keys are the PHONE's, not this window's: nd-core echoes each one it
    queues -- its own keypad, the viewer's, nd-key's -- through nd-watchd, so
    a finger on the real keypad lights up here. That is the point of it: the
    one input a developer at the desk cannot otherwise see. (It needs the
    key echo in nd-core; against an older image the keypad stays dark and
    only the stats appear.)

    CPU and RAM come from nd-watchd every ten seconds, the first a second
    after connecting."""

    W, H = 300, 500
    BG, KEY, LIT, INK, DIM = (22, 22, 26), (52, 52, 60), (70, 170, 255), (235, 235, 235), (140, 140, 150)

    def __init__(self, nd):
        from pygame._sdl2 import video
        self.video = video
        self.win = video.Window("NeoDCT keys", size=(self.W, self.H))
        self.ren = video.Renderer(self.win)
        self.surf = pygame.Surface((self.W, self.H))
        self.font = pygame.font.Font(None, 22)
        self.small = pygame.font.Font(None, 18)
        self.down = {}                 # code -> monotonic time pressed
        self.log = []                  # recent (name, held seconds or None)
        self.names = {}
        for name, code in nd.items():  # the first name wins: NAVIKEY over ENTER
            if name in ("NONE", "INCOMING_CALL", "M", "BACK", "ENTER", "KPENTER", "C"):
                continue
            self.names.setdefault(code, name)
        # The phone's keys and no others: NaviKey, C, up, down, the twelve.
        # None is an empty cell, so DOWN sits under UP as it does on the phone.
        rows = [[("NAVI", nd["NAVIKEY"]), ("UP", nd["UP"]), ("C", nd["CLEAR"])],
                [None, ("DOWN", nd["DOWN"]), None],
                [("1", nd["1"]), ("2", nd["2"]), ("3", nd["3"])],
                [("4", nd["4"]), ("5", nd["5"]), ("6", nd["6"])],
                [("7", nd["7"]), ("8", nd["8"]), ("9", nd["9"])],
                [("*", nd["STAR"]), ("0", nd["0"]), ("#", nd["HASH"])]]
        self.grid = rows
        self.on_grid = {cell[1] for row in rows for cell in row if cell}
        for row in rows:                   # the history says what the key says
            for cell in row:
                if cell:
                    self.names[cell[1]] = cell[0]

    def is_window(self, ev):
        w = getattr(ev, "window", None)
        return w is not None and getattr(w, "id", None) == self.win.id

    def feed(self, events):
        for code, down, at in events:
            if down:
                self.down[code] = at
            else:
                start = self.down.pop(code, None)
                self.log.append((self.names.get(code, str(code)),
                                 None if start is None else at - start))
                self.log = self.log[-6:]

    def clear(self):
        self.down.clear()

    def _bar(self, y, label, frac, text):
        s = self.surf
        s.blit(self.small.render(label, True, self.DIM), (14, y))
        pygame.draw.rect(s, self.KEY, (70, y, 216, 14), border_radius=3)
        if frac is not None:
            f = max(0.0, min(1.0, frac))
            col = (90, 200, 120) if f < 0.6 else (230, 190, 70) if f < 0.85 else (235, 90, 80)
            pygame.draw.rect(s, col, (70, y, max(2, int(216 * f)), 14), border_radius=3)
        s.blit(self.small.render(text, True, self.INK), (74, y + 16))

    def draw(self, link, now):
        s = self.surf
        s.fill(self.BG)
        s.blit(self.font.render("Keys on the phone", True, self.INK), (14, 10))
        bw, bh, gap, x0, y0 = 84, 38, 8, 14, 36
        for r, row in enumerate(self.grid):
            for c, cell in enumerate(row):
                if cell is None:
                    continue
                label, code = cell
                rect = pygame.Rect(x0 + c * (bw + gap), y0 + r * (bh + gap), bw, bh)
                lit = code in self.down
                pygame.draw.rect(s, self.LIT if lit else self.KEY, rect, border_radius=7)
                t = self.font.render(label, True, (10, 10, 10) if lit else self.INK)
                s.blit(t, t.get_rect(center=rect.center))
        y = y0 + len(self.grid) * (bh + gap)
        other = [self.names.get(c, str(c)) for c in self.down if c not in self.on_grid]
        s.blit(self.small.render("also held: " + (", ".join(other) or "-"), True, self.DIM), (14, y))
        y += 18
        recent = "  ".join(n if h is None else "%s %.2fs" % (n, h) for n, h in reversed(self.log))
        s.blit(self.small.render("last: " + (recent or "-"), True, self.DIM), (14, y))

        y += 30
        st = link.stats
        if st is None:
            s.blit(self.small.render("CPU / RAM: waiting for the phone...", True, self.DIM), (14, y))
        else:
            cpu = st["cpu"]
            self._bar(y, "CPU", None if cpu is None else cpu / 100.0,
                      "measuring..." if cpu is None else "%.1f%%" % cpu)
            used = st["total"] - st["avail"]
            self._bar(y + 38, "RAM", used / st["total"] if st["total"] else None,
                      "%.1f of %.1f MB used" % (used / 1024.0, st["total"] / 1024.0))
            if st["stotal"]:
                su = st["stotal"] - st["sfree"]
                self._bar(y + 76, "swap", su / st["stotal"],
                          "%.1f of %.1f MB" % (su / 1024.0, st["stotal"] / 1024.0))
            s.blit(self.small.render("updated %ds ago, every 10s" % int(now - st["at"]),
                                     True, self.DIM), (14, self.H - 20))
        tex = self.video.Texture.from_surface(self.ren, s)
        self.ren.clear()
        self.ren.blit(tex)
        self.ren.present()

    def close(self):
        self.win.destroy()


def main(argv=None):
    ap = argparse.ArgumentParser(prog="ndlink-watch")
    ap.add_argument("--host", required=True)
    ap.add_argument("--port", type=int, default=5901)
    ap.add_argument("--view-only", action="store_true")
    ap.add_argument("--no-audio", action="store_true")
    ap.add_argument("--no-mute", action="store_true",
                    help="leave the phone's own speaker on while watching")
    ap.add_argument("--latency", type=int, default=60,
                    help="least audio buffer, ms (grows to fit bursty apps)")
    ap.add_argument("--scale", type=int, default=3, help="initial window scale")
    ap.add_argument("--verbose", action="store_true",
                    help="a second window: the phone's pressed keys, CPU and RAM")
    args = ap.parse_args(argv)

    nd = load_keycodes()
    by_char, by_key = build_keymap(nd)

    # Not pygame.init(): that also opens the mixer, a stream of silence in
    # the desktop's mixer that looks exactly like this viewer's audio and is
    # not. Sound goes through AudioOut; only video and fonts come from here.
    pygame.display.init()
    pygame.font.init()
    pygame.key.set_repeat()          # held state is the phone's to repeat
    flags = pygame.RESIZABLE
    screen = pygame.display.set_mode((FB_W * args.scale, FB_H * args.scale), flags)
    pygame.display.set_caption("NeoDCT -- %s" % args.host)
    font = pygame.font.Font(None, 22)

    audio = None if args.no_audio else AudioOut(max(20, args.latency))
    link = Link(args.host, args.port, audio, mute_phone=not args.no_mute)
    canvas = pygame.Surface((FB_W, FB_H))
    canvas.fill((0, 0, 0))
    keys_win = KeysWindow(nd) if args.verbose else None
    keys_drawn = 0.0

    scaler = 0
    fullscreen = False
    held = {}                        # pygame key -> NeoDCT code sent down
    dirty = True
    clock = pygame.time.Clock()
    stat_t = time.monotonic()
    title = ""

    running = True
    while running:
        for ev in pygame.event.get():
            if ev.type == pygame.WINDOWCLOSE and keys_win is not None and keys_win.is_window(ev):
                keys_win.close()
                keys_win = None
                continue
            if ev.type == pygame.QUIT:
                running = False
            elif ev.type in (pygame.VIDEORESIZE, pygame.WINDOWSIZECHANGED):
                dirty = True
            elif ev.type == pygame.KEYDOWN:
                mods = ev.mod
                if ev.key == pygame.K_q and mods & pygame.KMOD_CTRL:
                    running = False
                elif ev.key == pygame.K_F2:
                    scaler = (scaler + 1) % len(SCALERS)
                    dirty = True
                elif ev.key == pygame.K_F3 and audio is not None:
                    audio.muted = not audio.muted
                elif ev.key == pygame.K_F4:
                    link.mute_phone = not link.mute_phone
                    link.send_options()
                elif ev.key == pygame.K_F11 or (ev.key == pygame.K_RETURN and mods & pygame.KMOD_ALT):
                    fullscreen = not fullscreen
                    pygame.display.toggle_fullscreen()
                    dirty = True
                elif not args.view_only and ev.key not in held:
                    code = by_char.get(ev.unicode) if ev.unicode else None
                    if code is None:
                        code = by_key.get(ev.key)
                    if code is not None:
                        held[ev.key] = code
                        link.send_key(code, True)
            elif ev.type == pygame.KEYUP:
                code = held.pop(ev.key, None)
                if code is not None:
                    link.send_key(code, False)
            elif ev.type == pygame.WINDOWFOCUSLOST:
                # A key held when focus leaves never gets its KEYUP here.
                for code in held.values():
                    link.send_key(code, False)
                held.clear()

        events = link.take_key_events()
        if keys_win is not None:
            now = time.monotonic()
            if link.sock is None:
                keys_win.clear()
            if events or now - keys_drawn >= 1.0:
                keys_win.feed(events)
                keys_win.draw(link, now)
                keys_drawn = now

        for x, y, w, h, data in link.take_rects():
            blit_565(canvas, x, y, w, h, data)
            dirty = True

        if dirty or link.status or (audio is not None and audio.error):
            screen.fill((24, 24, 24))
            img, pos = fit(canvas, screen.get_size(), SCALERS[scaler])
            screen.blit(img, pos)
            note = link.status or (audio.error if audio is not None else None)
            if note:
                txt = font.render(note, True, (255, 210, 80))
                screen.blit(txt, (8, screen.get_height() - txt.get_height() - 6))
            pygame.display.flip()
            dirty = False

        now = time.monotonic()
        if now - stat_t >= 1.0:
            dt = now - stat_t
            parts = ["NeoDCT -- %s" % args.host]
            if link.hello:
                parts.append("%.0f fps" % (link.frames / dt))
                parts.append("%.1f Mbit/s" % ((link.video_bytes + link.audio_bytes) * 8 / dt / 1e6))
                if audio is not None and audio.proc is not None:
                    parts.append("%g kHz%s, %d ms" % (audio.fmt[0] / 1000.0,
                                                      " (muted)" if audio.muted else "",
                                                      audio.target_ms()))
                elif audio is not None and audio.error:
                    parts.append("NO AUDIO")
                if link.hello and not link.hello["keys"] or args.view_only:
                    parts.append("view only")
                parts.append("phone speaker %s" % ("off" if link.mute_phone and not args.view_only else "on"))
                parts.append(SCALERS[scaler])
            link.frames = link.video_bytes = link.audio_bytes = 0
            stat_t = now
            t = "  |  ".join(parts)
            if t != title:
                pygame.display.set_caption(t)
                title = t

        clock.tick(60)

    for code in held.values():
        link.send_key(code, False)
    link.stop = True
    if keys_win is not None:
        keys_win.close()
    if audio is not None:
        audio.close()
    pygame.quit()
    return 0


if __name__ == "__main__":
    sys.exit(main())
