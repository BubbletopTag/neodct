def player_argv(rate, ch, bits, latency_ms):
    """The desktop's own raw-PCM player, or None.

    Not SDL. pygame's AudioDevice needs a device NAME -- it refuses None and
    answers '' with "No such device" -- and a name pins the stream to one
    output, so plugging in headphones would leave the phone in the speakers.
    The sound server's own client follows the default output like any other
    program on the desktop, and pw-play/paplay/aplay all take raw stdin."""
    fmt = {8: ("u8", "U8"), 16: ("s16", "S16_LE"), 32: ("s32", "S32_LE")}.get(bits)
    if fmt is None:
        return None
    if shutil.which("pw-play"):
        return ["pw-play", "--raw", "--rate", str(rate), "--channels", str(ch),
                "--format", fmt[0], "--latency", "%dms" % latency_ms, "-"]
    if shutil.which("paplay"):
        return ["paplay", "--raw", "--rate=%d" % rate, "--channels=%d" % ch,
                "--format=%sle" % fmt[0] if bits > 8 else "--format=u8",
                "--latency-msec=%d" % latency_ms]
    if shutil.which("aplay"):
        return ["aplay", "-q", "-t", "raw", "-f", fmt[1], "-r", str(rate),
                "-c", str(ch), "-B", str(latency_ms * 1000), "-"]
    return None


class AudioOut:
    """The phone's audio, piped into a player the desktop routes, through a
    jitter buffer sized to how the audio actually arrives.

    It arrives in bursts, and the burst is the APP'S choice, not ours: the
    tap can only hand over what the app has written, and alsa-lib's file
    plugin passes it on one app period at a time. aplay's default is a 500 ms
    ring in 125 ms periods (the ringtones), mpv's is 20 ms. A fixed 80 ms
    buffer was fine for mpv and choppy for every ringtone -- each 125 ms burst
    overflowed it and the rest was thrown away.

    So the target is measured: the longest gap between arrivals over the last
    few seconds, plus a margin, never below --latency. Playback starts once
    that much is queued; if the player runs dry it waits to refill rather
    than stutter; and anything that would push the queue a full burst past
    the target is dropped, whole frames only, so latency cannot creep.

    The queue is the pipe to the player itself -- FIONREAD on the write end
    says how full it is -- and every write is non-blocking: the network
    thread writes here, and a stalled sound server must not stall the
    picture with it."""

    PLAYER_MS = 30          # the player's own buffer; ours is the pipe
    MAX_TARGET_MS = 500

    def __init__(self, latency_ms, argv_for=player_argv):
        self.latency_ms = latency_ms
        self.argv_for = argv_for
        self.proc = None
        self.fmt = None
        self.muted = False
        self.dropped = 0
        self.underruns = 0
        self.error = None
        self.pending = b""      # the rest of a frame a short write cut in two
        self.prime = bytearray()
        self.primed = False
        self.last = None
        self.gaps = []          # (time, gap ms) over the last few seconds

    def _start(self, fmt):
        self.close()
        self.fmt = fmt
        self.pending = b""
        self.prime = bytearray()
        self.primed = False
        argv = self.argv_for(*fmt, self.PLAYER_MS)
        if argv is None:
            self.error = "no audio: need pw-play, paplay or aplay for %d-bit" % fmt[2]
            return
        try:
            self.proc = subprocess.Popen(argv, stdin=subprocess.PIPE,
                                         stdout=subprocess.DEVNULL,
                                         stderr=subprocess.DEVNULL)
        except OSError as exc:
            self.error = "no audio: %s" % exc
            return
        fd = self.proc.stdin.fileno()
        try:            # room for a whole second; the target keeps it far emptier
            fcntl.fcntl(fd, 1031, max(65536, self._bpms() * 1000))  # F_SETPIPE_SZ
        except OSError:
            pass
        os.set_blocking(fd, False)
        self.error = None

    def _bpms(self):
        rate, ch, bits = self.fmt
        return rate * ch * (bits // 8) // 1000

    def target_ms(self):
        worst = max((g for _, g in self.gaps), default=0.0)
        return int(min(self.MAX_TARGET_MS, max(self.latency_ms, worst * 1.3 + 20)))

    def queued_ms(self):
        b = array.array("i", [0])
        try:
            fcntl.ioctl(self.proc.stdin.fileno(), termios.FIONREAD, b)
        except OSError:
            return 0.0
        return (b[0] + len(self.prime)) / max(1, self._bpms())

    def _write(self, data, frame):
        data = self.pending + bytes(data)
        self.pending = b""
        try:
            n = os.write(self.proc.stdin.fileno(), data)
        except BlockingIOError:
            n = 0
        except OSError as exc:            # the player died
            self.error = "no audio: player exited (%s)" % exc
            self.proc = None
            return
        if n < len(data):
            # A short write can stop inside a frame. Dropping the rest of it
            # would shift every later sample -- noise, or the channels swapped
            # -- for as long as the player runs, so the tail of that one frame
            # is carried and only whole frames are ever dropped.
            self.dropped += 1
            cut = n % frame
            if cut:
                self.pending = data[n:n + frame - cut]

    def push(self, rate, ch, bits, pcm, now=None):
        now = time.monotonic() if now is None else now
        fmt = (rate, ch, bits)
        if fmt != self.fmt or (self.proc is not None and self.proc.poll() is not None):
            self._start(fmt)
            self.gaps = []
            self.last = None
        if self.last is not None:
            self.gaps.append((now, (now - self.last) * 1000.0))
        self.last = now
        self.gaps = [(t, g) for t, g in self.gaps if now - t < 4.0]
        if self.proc is None:
            return
        if self.muted:
            self.primed = False
            self.prime = bytearray()
            return

        frame = ch * (bits // 8)
        target = self.target_ms()
        if self.primed:
            queued = self.queued_ms()
            if queued <= 0:
                # Ran dry: a gap now is better than one every burst from here on.
                self.underruns += 1
                self.primed = False
            elif queued > target + max(g for _, g in self.gaps[-8:] or [(0, 0)]) + 60:
                self.dropped += 1
                return
        if not self.primed:
            self.prime += pcm
            if len(self.prime) >= target * self._bpms():
                data, self.prime = self.prime, bytearray()
                self.primed = True
                self._write(data, frame)
            return
        self._write(pcm, frame)

    def close(self):
        if self.proc is not None:
            try:
                self.proc.stdin.close()
            except OSError:
                pass
            self.proc.terminate()
            self.proc = None


