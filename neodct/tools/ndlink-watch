HERE = os.path.dirname(os.path.realpath(__file__))
KEYCODES_H = os.path.join(HERE, "..", "src", "include", "nd_keycodes.h")

FB_W, FB_H = 240, 175
HDR = struct.Struct("<B3xI")


def load_keycodes(path=KEYCODES_H):
    """ND_KEY_* from the C header, so there is one keymap and not two."""
    codes = {}
    with open(path, encoding="utf-8") as f:
        for m in re.finditer(r"#define\s+ND_KEY_(\w+)\s+(-?\d+)", f.read()):
            codes[m.group(1)] = int(m.group(2))
    return codes


def build_keymap(nd):
    """(by_char, by_key): what a keypress means on the phone.

    Characters first, because '*' and '#' are shifted keys on most layouts
    and the character is the only thing that says which one was meant."""
    by_char = {str(d): nd[str(d)] for d in range(10)}
    by_char.update({"*": nd["STAR"], "#": nd["HASH"], "-": nd["MINUS"],
                    ".": nd["DOT"], ",": nd["COMMA"], " ": nd["SPACE"],
                    "m": nd["MENU"], "M": nd["MENU"]})
    by_key = {
        pygame.K_UP: nd["UP"], pygame.K_DOWN: nd["DOWN"],
        pygame.K_RETURN: nd["NAVIKEY"], pygame.K_KP_ENTER: nd["NAVIKEY"],
        pygame.K_BACKSPACE: nd["CLEAR"], pygame.K_ESCAPE: nd["CLEAR"],
        pygame.K_KP_MULTIPLY: nd["STAR"],
    }
    for d in range(10):
        by_key[getattr(pygame, "K_KP%d" % d)] = nd[str(d)]
    return by_char, by_key


