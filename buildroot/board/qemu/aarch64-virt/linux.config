CONFIG_SND_HDA_INTEL=y
# The controller alone exposes no PCM devices: without a codec driver the HDA
# card binds and offers nothing, so /proc/asound has no pcm*c node and the
# guest has no microphone at all. QEMU's hda-duplex presents a generic codec,
# which is what makes an emulated CAPTURE device possible -- and capture is not
# something usb-audio can do here. MicTest is unusable in QEMU without this.
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_VIRTIO=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_MAILBOX=y
CONFIG_PL320_MBOX=y
CONFIG_ARM_SMMU_V3=y
CONFIG_EXT4_FS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZORLE=y
CONFIG_CRYPTO_LZO=y

# --- Immutable system: read-only squashfs root, verified with dm-verity ---
# The rootfs is a squashfs image on its own device; zstd is the build
# default (best decompress speed per byte on a 1GHz core with 64MB of RAM),
# xz and zlib stay enabled so older .ndsw images keep booting.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZLIB=y
# The initramfs applier writes a staged update before the root is mounted.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# Loop lets the applier mount and inspect a staged image file.
CONFIG_BLK_DEV_LOOP=y
# dm-verity: DM_VERITY selects CRYPTO_HASH but no specific algorithm, so
# CRYPTO_SHA256 has to be asked for explicitly or the table load fails.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y
# --- FAT32 SD cards (wallpapers, tones, music, UPDATE.ndsw) ---
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# --- Bluetooth: the kernel IS the whole stack ---
#
# There is no bluetoothd on this phone and no plan for one. Everything the
# Bluetooth engineering app does -- enumerate controllers, read BD_ADDR,
# HCIDEVUP, run an inquiry -- is an ioctl on an AF_BLUETOOTH socket, served
# by the kernel's own BlueZ core. Adding BR2_PACKAGE_BLUEZ5_UTILS instead
# would drag in dbus and libglib2 and a resident daemon for a feature that is
# engineering-only, on a device with 64 MB of RAM. See neodct/src/include/
# nd_bt.h for the full argument and for when it stops holding (pairing,
# audio, RFCOMM).
#
# BT_BREDR is spelled out rather than left to its `default y`: hci_inquiry()
# refuses with EOPNOTSUPP unless HCI_BREDR_ENABLED is set, so it is what makes
# "Scan" work at all rather than a nicety.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_HCIBTUSB=y
# The TP-Link UB500 (2357:0604) is an RTL8761BU. btusb matches it on the USB
# class (e0/01/01) so no id table entry is needed, but the part has no
# firmware of its own: btrtl reads its LMP subversion and then asks for
# rtl_bt/rtl8761bu_fw.bin + rtl8761bu_config.bin. Without RTL support the
# controller registers with BD_ADDR 00:00:00:00:00:00 and never comes up,
# which is precisely the failure the app's ADDRESS step is there to name.
CONFIG_BT_HCIBTUSB_RTL=y
# Broadcom and Intel protocol support are dead weight for a phone that ships
# with one known dongle. BT_HCIBTUSB selects BT_INTEL unconditionally, so
# only the Broadcom half can actually be dropped.
# CONFIG_BT_HCIBTUSB_BCM is not set
# The virtual controller, for QEMU only -- this file is not the Luckfox
# kernel. USB passthrough into QEMU needs write access to the dongle's
# /dev/bus/usb node, i.e. root or a udev rule, so on a machine that has
# neither this is the only way to get an hci device inside the guest and
# exercise the ioctl path on the target architecture. Holding /dev/vhci open
# for a second is enough to make one appear. ~8 KB.
CONFIG_BT_HCIVHCI=y
# The firmware loader btrtl needs. Already on for other reasons on most
# configs; named here because BT_RTL only `select`s it, and a config that
# lost it would fail in the confusing zero-address way described above.
CONFIG_FW_LOADER=y

# --- MTD + UBI: so the REAL update path can be tested here ----------------
#
# This kernel is not the phone's, and none of this exists on the phone's
# behalf. It is here because the phone's system partition is a static UBI
# volume behind a read-only ubiblock disk, and updates never once installed
# on real hardware while every test on this side passed -- the applier dd'd,
# dd cannot write ubiblock, and the failure path logs "retrying on the next
# boot" and boots the old system. Nothing in QEMU could see that, because
# here the system device is /dev/vda and dd is perfectly happy.
#
# With UBI available, neodct/tools/test_update_ubi.sh builds a real static
# volume on a RAM-backed MTD and drives the real applier at it. Real
# ubiupdatevol, real transaction semantics, real ENOSPC when an image does
# not fit the volume -- which is the next thing that can go wrong, since
# mknand.sh sizes the volume to exactly the image it was flashed with.
#
# MTDRAM IS A MODULE ON PURPOSE. Built in, it allocates its whole backing
# store at boot, and this VM has 72 MB. As a module it costs nothing until a
# test loads it with the geometry it wants.
CONFIG_MTD=y
CONFIG_MTD_BLKDEVS=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_MTDRAM=m
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_BLOCK=y

# --- a virtual sound card WITH CAPTURE, for testing the microphone path ---
#
# S17audio has to leave the capture switch on and the mic gain up, because
# nothing else in the image does: there is no alsactl, so no saved mixer state
# is restored and the phone gets the driver's defaults on every boot. That was
# invisible while the only microphone was an ONN, whose defaults are open. A
# C-Media card with an electret soldered to it comes up muted, and arecord then
# returns silence with no error -- which MicTest draws faithfully as a flat
# line, looking exactly like dead hardware.
#
# Testing that needs a card with real capture controls, and USB passthrough
# needs the microphone physically present. snd-dummy has both a capture stream
# and a mixer, so the script can be driven against real ALSA and a real amixer
# rather than a fake one -- and the parsing of amixer's output, which is the
# fragile part of the fix, is then tested against the genuine article.
#
# A MODULE, like mtdram: it costs nothing until a test loads it.
CONFIG_SND_DUMMY=m
