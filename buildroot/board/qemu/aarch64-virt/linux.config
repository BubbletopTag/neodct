# --- Immutable system: read-only squashfs root, verified with dm-verity ---
# The rootfs is a squashfs image on its own device; zstd is the build
# default (best decompress speed per byte on a 1GHz core with 64MB of RAM),
# xz and zlib stay enabled so older .ndsw images keep booting.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZLIB=y
# The initramfs applier writes a staged update before the root is mounted.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# Loop lets the applier mount and inspect a staged image file.
CONFIG_BLK_DEV_LOOP=y
# dm-verity: DM_VERITY selects CRYPTO_HASH but no specific algorithm, so
# CRYPTO_SHA256 has to be asked for explicitly or the table load fails.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y
# --- FAT32 SD cards (wallpapers, tones, music, UPDATE.ndsw) ---
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
