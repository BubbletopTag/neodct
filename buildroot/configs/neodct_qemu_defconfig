BR2_aarch64=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_JLEVEL=8
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_GENERIC_HOSTNAME="neodct"
BR2_TARGET_GENERIC_ISSUE="NeoDCT System v0.3.0a"
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="board/qemu/busybox.fragment"
BR2_PACKAGE_MPV=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_SYSTEM_DHCP=""
BR2_TARGET_TZ_INFO=y
BR2_ROOTFS_OVERLAY="../neodct/overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/qemu/post-image.sh ../neodct/scripts/post-image-neodct.sh"
BR2_ROOTFS_POST_BUILD_SCRIPT="../neodct/scripts/post-build-prune-tests.sh ../neodct/scripts/post-build-system-metadata.sh"
BR2_ROOTFS_POST_BUILD_SCRIPT_ARGS="qemu-aarch64"
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_DEFCONFIG)"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.47"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_GPM=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON_PILLOW=y
BR2_PACKAGE_PYTHON_MUTAGEN=y
BR2_PACKAGE_PYTHON_MINIAUDIO=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LINKS=y
BR2_PACKAGE_LINKS_GRAPHICS=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_UQMI=y
BR2_PACKAGE_NETSURF=y
BR2_PACKAGE_NETSURF_FRAMEBUFFER=y

# --- Immutable system (squashfs root + dm-verity + SD cards) ---
# The squashfs is the real root from now on; rootfs.ext4 is kept for the
# moment so the old direct-boot flow still works during the transition.
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# dm-verity needs a device-mapper client. Without STANDARD_INSTALL lvm2
# installs dmsetup + libdevmapper only (~400KB) instead of the whole LVM
# suite, and dmsetup is all the initramfs needs to load a verity table.
BR2_PACKAGE_LVM2=y
# BR2_PACKAGE_LVM2_STANDARD_INSTALL is not set
# FAT32 SD cards: mkfs.vfat to format one, fatlabel to name it NEODCT,
# fsck.fat to repair a card the user pulled out mid-write.
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
# Host side: post-image builds userdata.ext4 and a FAT32 sdcard.img, and
# copies files into the latter with mcopy (no root, no loop mounts).
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
