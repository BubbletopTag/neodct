############################
# Buildroot generated data
############################
buildroot/output/
buildroot/dl/

# Out-of-tree build dirs
build-*/
output-*/

############################
# Python
############################
__pycache__/
*.pyc
*.pyo

############################
# Editors / OS junk
############################
.DS_Store
*.swp
*.swo
*.tmp

############################
# Secrets / keys (never commit)
############################
*.pem
*.key
*.crt
secrets/

############################
# NeoDCT user data (runtime content)
############################
neodct/overlay/User/music/

############################
# NeoDCT large test media (keep repo lean)
############################
neodct/overlay/tests/*.avi
neodct/overlay/tests/*.mp3
neodct/overlay/tests/*.mp4
neodct/overlay/tests/*.mkv
# want this in the repo
# netsurf-neodct/

############################
# Agent tooling (local only)
############################
.claude/

############################
# Editor droppings in the overlay
############################
# Whatever sits in the overlay gets copied into the image and signed with
# it. A LibreOffice lock file reached /NeoDCT that way once; the build
# prunes them now (post-build-prune-tests.sh), and they must not be
# committable either.
.~lock.*#
*.swp
*~
.#*

############################
# Apps still being experimented with
############################
# In the overlay so it can be worked on, ignored so it neither lands in a
# commit nor blocks a release tag. The build leaves it out via
# NEODCT_EXCLUDE_APPS=Tube. Remove this line when Tube is ready to ship.
neodct/overlay/NeoDCT/System/apps/Tube/
